<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/responsive.css">
  <title>Painel Administrativo | Regimath</title>

  <!-- Fonts & Icons -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="icon" href="/imagens/Regimath_sem fundo cor preto2.png" />

  <!-- Estilos -->
  <link rel="stylesheet" href="/css/painel_adm.css">
  <link rel="stylesheet" href="../css/accessibility.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  </head>

<body>
  <!-- Header -->
  <header>
    <a href="/" class="logo-link" aria-label="Página inicial Regimath">
      <img src="/imagens/RM_bordo.png" alt="Logo Regimath" class="logo">
    </a>
    <button id="menu-btn" class="menu-btn" aria-label="Abrir menu">☰</button>
  </header>

  <!-- Overlay (para mobile) -->
  <section id="overlay"></section>

  <!-- Menu lateral -->
  <nav id="menu" aria-label="Menu lateral administrativo">
    <button id="close-menu" aria-label="Fechar menu">&times;</button>
    <button id="toggle-menu" aria-label="Recolher menu">
      <svg id="toggle-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="white">
        <path d="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
      </svg>
    </button>

    <ul class="nav-links">
      <li><a href="#page-dashboard" class="admin-nav-link active"><i class="fa-solid fa-chart-pie"></i><p class="label">Dashboard</p></a></li>
      <li><a href="#page-users" class="admin-nav-link"><i class="fa-solid fa-users"></i><p class="label">Usuários</p><p class="badge" id="pending-teachers-badge"><%= pagination.totalItems %></p></a></li>
      <li><a href="#page-finance" class="admin-nav-link"><i class="fa-solid fa-wallet"></i><p class="label">Financeiro</p></a></li>
      <li><a href="#page-moderation" class="admin-nav-link"><i class="fa-solid fa-shield-halved"></i><p class="label">Moderação</p><p class="badge" id="open-reports-badge"><%= typeof openReports !== 'undefined' ? openReports : 0 %></p></a></li>
      <% if (typeof adminUser !== 'undefined' && adminUser && adminUser.role === 'superadmin') { %>
      <li><a href="#page-admins" class="admin-nav-link"><i class="fa-solid fa-user-shield"></i><p class="label">Administradores</p></a></li>
      <% } %>
      <li><a href="/" class="admin-nav-link"><i class="fas fa-home"></i><p class="label">Home</p></a></li>
      <li class="a11y-fab pa"><button id="a11y-open-modal" aria-label="Abrir painel de acessibilidade" style="background: transparent; border: none; color: #fff; font-size: 1.1rem; cursor: pointer;"><i class="fas fa-universal-access"></i>Acessibilidade</button></li>
      <li><a href="/logout" class="admin-nav-link"><svg xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="#fff"><path d="M216-144q-29.7 0-50.85-21.15Q144-186.3 144-216v-528q0-29.7 21.15-50.85Q186.3-816 216-816h264v72H216v528h264v72H216Zm432-168-51-51 81-81H384v-72h294l-81-81 51-51 168 168-168 168Z"/></svg><p class="label">Sair</p></a></li>
    </ul>
  </nav>

  <!-- Conteúdo principal -->
  <main>
    <section class="admin-header-content">
      <h1 id="page-title">Dashboard</h1>
      <section class="admin-profile">
        <i class="fa-solid fa-user-shield"></i> Olá, <strong>Admin</strong>
      </section>
    </section>

    <!-- DASHBOARD -->
    <section class="content-page active" id="page-dashboard">
      <section class="kpi-grid">
        <section class="kpi-card success">
          <section class="kpi-label">Receita da Plataforma (Mês)</section>
          <section id="kpi-revenue" class="kpi-value">Carregando...</section>
        </section>
        <section class="kpi-card warning">
          <section class="kpi-label">Valores retidos e repasses devidos</section>
          <section id="kpi-pending-payments" class="kpi-value">Carregando...</section>
        </section>
        <section class="kpi-card">
          <section class="kpi-label">Novos Alunos (Mês)</section>
          <section id="kpi-new-students" class="kpi-value">Carregando...</section>
        </section>
        <section class="kpi-card">
          <section class="kpi-label">Aulas Concluídas (Mês)</section>
          <section id="kpi-completed-classes" class="kpi-value">Carregando...</section>
        </section>
         <section class="kpi-card">
          <section class="kpi-label">Denúncias Abertas</section>
          <section id="kpi-open-reports" class="kpi-value">Carregando...</section>
        </section>
      </section>

      <section class="card" style="margin-top: 30px;">
        <h2 class="section-title">Atividade Recente</h2>
        <ul style="list-style: none; padding-left: 10px;" id="recent-activity-list">
        </ul>
      </section>
    </section>

    <!-- USUÁRIOS -->
    <section class="content-page" id="page-users">
        
        <section class="card">
            <h2 class="section-title">Professores Aguardando Aprovação (<%= pagination.totalItems %>)</h2>
            
            <form action="/admin/dashboard" method="GET" class="filter-form">
                <input type="hidden" name="status" value="pending">
                <input type="search" name="search" placeholder="Buscar por nome ou email..." value="<%= pagination.search || '' %>">
                <button type="submit" class="btn btn-primary" onclick="window.location.hash = '#page-users';">Filtrar</button>
            </form>

            <section class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Email</th>
                            <th>Formação</th>
                            <th>Perfil enviado em</th>
                            <th>Registrado em</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(pendingTeachers.length > 0) { %>
                            <% pendingTeachers.forEach(teacher => { %>
                                <tr>
                                    <td><%= teacher.nome %></td>
                                    <td><%= teacher.email %></td>
                                    <td><%= teacher.formacao || '—' %></td>
                                    <td><%= teacher.perfil_enviado_em ? new Date(teacher.perfil_enviado_em).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' }) : '—' %></td>
                                    <td><%= new Date(teacher.criado_em).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' }) %></td>
                                    <td class="actions-buttons">
                                        <a href="/admin/teachers/<%= teacher.id %>" title="Ver detalhes" class="btn btn-primary" style="display: inline-flex; align-items: center; justify-content: center;"><i class="fa-solid fa-eye"></i>Ver detalhes</a>
                                        <form action="/admin/teachers/<%= teacher.id %>/approve" method="POST" style="display: inline;">
                                            <button title="Aprovar" type="submit" class="btn btn-success"><i class="fa-solid fa-check"></i></button>
                                        </form>
                                        <form action="/admin/teachers/<%= teacher.id %>/reject" method="POST" style="display: inline;">
                                            <textarea name="reason" placeholder="Motivo..." required style="width: 100px; height: 30px; vertical-align: middle;"></textarea>
                                            <button title="Rejeitar" type="submit" class="btn btn-error"><i class="fa-solid fa-times"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="6">Nenhum professor encontrado com os filtros atuais.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </section>

            <% if(pagination.totalPages > 1) { %>
                <nav class="pagination">
                    <ul>
                        <% if(pagination.page > 1) { %>
                            <li><a href="/admin/dashboard?page=<%= pagination.page - 1 %>&status=<%= pagination.status %>&search=<%= pagination.search || '' %>#page-users">Anterior</a></li>
                        <% } %>

                        <% for(let i = 1; i <= pagination.totalPages; i++) { %>
                            <li class="<%= i === pagination.page ? 'active' : '' %>">
                                <a href="/admin/dashboard?page=<%= i %>&status=<%= pagination.status %>&search=<%= pagination.search || '' %>#page-users"><%= i %></a>
                            </li>
                        <% } %>

                        <% if(pagination.page < pagination.totalPages) { %>
                            <li><a href="/admin/dashboard?page=<%= pagination.page + 1 %>&status=<%= pagination.status %>&search=<%= pagination.search || '' %>#page-users">Próximo</a></li>
                        <% } %>
                    </ul>
                </nav>
            <% } %>
        </section>

        <section class="card">
            <h2 class="section-title">Professores Ativos (<%= approvedTeachers.length %>)</h2>
            <section class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Email</th>
                            <th>Status</th>
                            <th>Registrado em</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% approvedTeachers.forEach(teacher => { %>
                            <tr>
                                <td><%= teacher.nome %></td>
                                <td><%= teacher.email %></td>
                                <td><output class="status-badge status-<%= teacher.aprovacao_status %>"><%= teacher.aprovacao_status %></output></td>
                                <td><%= new Date(teacher.criado_em).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' }) %></td>
                                <td class="actions-buttons">
                                    <form action="/admin/teachers/<%= teacher.id %>/suspend" method="POST" style="display: inline;">
                                        <textarea name="reason" placeholder="Motivo da suspensão..." required style="width: 100px; height: 30px; vertical-align: middle;"></textarea>
                                        <button title="Suspender" type="submit" class="btn btn-warning"><i class="fa-solid fa-ban"></i></button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </section>
        </section>
        
        <section class="card">
            <h2 class="section-title">Professores Inativos e Suspensos (<%= inactiveTeachers.length %>)</h2>
            <section class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Email</th>
                            <th>Status</th>
                            <th>Registrado em</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% inactiveTeachers.forEach(teacher => { %>
                            <tr>
                                <td><%= teacher.nome %></td>
                                <td><%= teacher.email %></td>
                                <td><output class="status-badge status-<%= teacher.aprovacao_status %>"><%= teacher.aprovacao_status %></output></td>
                                <td><%= new Date(teacher.criado_em).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' }) %></td>
                                <td class="actions-buttons">
                                     <form action="/admin/teachers/<%= teacher.id %>/reactivate" method="POST" style="display: inline;">
                                        <button title="Reativar" type="submit" class="btn btn-primary"><i class="fa-solid fa-redo"></i></button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </section>
        </section>

    </section>

    <!-- FINANCEIRO -->
    <section class="content-page" id="page-finance">
        <section class="card">
            <h2 class="section-title">Repasses Pendentes</h2>
            <p>Pagamentos brutos ficam retidos até a aula ser concluída; depois, o valor líquido do professor fica disponível para repasse.</p>
            <section class="table-wrapper">
                <table class="data-table" id="pending-payouts-table">
                    <thead>
                        <tr>
                            <th>Professor</th>
                            <th>Valor retido / líquido a repassar</th>
                            <th>Situação</th>
                            <th>Data da Solicitação</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Linhas de repasses pendentes serão inseridas aqui -->
                    </tbody>
                </table>
            </section>
        </section>
        <section class="card">
            <h2 class="section-title">Extrato de Transações</h2>
            <section class="table-wrapper">
                <table class="data-table" id="transaction-history-table">
                    <thead>
                        <tr>
                            <th>ID Transação</th>
                            <th>Descrição</th>
                            <th>Valor bruto</th>
                            <th>Taxa plataforma</th>
                            <th>Líquido professor</th>
                            <th>Status</th>
                            <th>Data</th>
                            <th>Aluno</th>
                            <th>Professor</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Linhas do histórico de transações serão inseridas aqui -->
                    </tbody>
                </table>
            </section>
            <section class="pagination" id="transaction-pagination">
                <!-- Controles de paginação serão inseridos aqui -->
            </section>
        </section>
    </section>

    <!-- MODERAÇÃO -->
    <section class="content-page" id="page-moderation">
        <section class="card">
            <h2 class="section-title">Denúncias Recebidas (<%= (denuncias || []).length %>)</h2>
            <section class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Tipo</th>
                            <th>Título</th>
                            <th>Status</th>
                            <th>Enviada em</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (denuncias && denuncias.length > 0) { %>
                            <% denuncias.forEach(denuncia => { %>
                                <tr class="status-<%= denuncia.status.toLowerCase() %>">
                                    <td>#<%= denuncia.id %></td>
                                    <td><%= denuncia.tipo %></td>
                                    <td><%= denuncia.titulo %></td>
                                    <td><output class="status-badge status-<%= denuncia.status.toLowerCase().replace(' ', '-') %>"><%= denuncia.status %></output></td>
                                    <td><%= new Date(denuncia.criado_em).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }) %></td>
                                    <td class="actions-buttons">
                                        <button class="btn btn-primary" onclick='openDenunciaModal(<%- JSON.stringify(denuncia) %>)'>Ver Detalhes</button>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr><td colspan="6">Nenhuma denúncia recebida.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </section>
        </section>
    </section>

    <!-- MODAL DA DENÚNCIA -->
    <section id="denuncia-modal" class="modal">
        <section class="modal-content">
            <section class="close-button-space">
                <button type="button" class="close-button" aria-label="Fechar denúncia">&times;</button>
            </section>
            <h2 id="modal-title"></h2>
            <section class="modal-body">
                <p><strong>ID da Denúncia:</strong> <output id="modal-id"></output></p>
                <p><strong>Status:</strong> <output id="modal-status" class="status-badge"></output></p>
                <p><strong>Tipo:</strong> <output id="modal-tipo"></output></p>
                <p><strong>Data:</strong> <output id="modal-data"></output></p>
                <p><strong>Descrição:</strong></p>
                <p id="modal-descricao" class="descricao-box"></p>
                <p><strong>Item denunciado:</strong> <output id="modal-item-denunciado"></output></p>


                <section id="denunciante-info"></section>
                <section id="denunciado-info"></section>
                <section id="conteudo-info"></section>

                <p><strong>Conteúdo do Comentário:</strong></p>
                <p id="modal-comment-content" class="descricao-box"></p>

                <section id="evidencia-info"></section>

                <hr>

                <section id="historico-denuncia">
                    <h4>Histórico de Ações</h4>
                    <ul id="historico-lista"></ul>
                </section>

                <hr>

                <section class="admin-actions">
                    <h4>Ações de Moderação</h4>
                    <p id="denuncia-action-feedback" style="margin: 0 0 8px 0; font-size: 0.9em;"></p>
                    <form id="denuncia-actions-form"></form>
                </section>
            </section>
        </section>
    </section>

    <% if (typeof adminUser !== 'undefined' && adminUser && adminUser.role === 'superadmin') { %>
    <!-- ADMINISTRADORES -->
    <section class="content-page" id="page-admins">
      <section class="card">
        <h2 class="section-title">Cadastrar Administrador</h2>
        <p>Cadastre um novo administrador da plataforma (acesso restrito a superadmin).</p>
        <form id="create-admin-form">
          <section class="form-group">
            <label for="new-admin-email">E-mail</label>
            <input type="email" id="new-admin-email" name="email" required placeholder="email@exemplo.com">
          </section>
          <section class="form-group">
            <label for="new-admin-password">Senha</label>
            <input type="password" id="new-admin-password" name="senha" minlength="6" required placeholder="Mínimo 6 caracteres">
          </section>
          <section class="form-group">
            <label for="new-admin-role">Role</label>
            <select id="new-admin-role" name="role" required>
              <option value="admin">admin</option>
              <option value="superadmin">superadmin</option>
            </select>
          </section>
          <p id="create-admin-feedback" style="margin: 8px 0; font-size: 0.9em;"></p>
          <button type="submit" class="btn btn-primary"><i class="fa-solid fa-user-plus"></i> Cadastrar Administrador</button>
        </form>
      </section>
    </section>
    <% } %>
  </main>

  <!-- Scripts -->
   <script src="../js/accessibility.js"></script>
  <script>
    async function openDenunciaModal(denuncia) {
        document.getElementById('modal-title').innerText = `Detalhes da Denúncia: ${denuncia.titulo}`;
        document.getElementById('modal-id').innerText = `#${denuncia.id}`;
        document.getElementById('modal-tipo').innerText = denuncia.tipo;
        document.getElementById('modal-descricao').innerText = denuncia.descricao;
        
        const statusEl = document.getElementById('modal-status');
        statusEl.innerText = denuncia.status;
        statusEl.className = `status-badge status-${denuncia.status.toLowerCase().replace(' ', '-')}`;

        document.getElementById('modal-data').innerText = new Date(denuncia.criado_em).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' });

        const getUserType = async (userId) => {
            if (!userId) return null;
            try {
                const response = await fetch(`/api/user-type/${userId}`);
                if (!response.ok) return null;
                const data = await response.json();
                return data.tipo;
            } catch (error) {
                console.error(`Erro ao buscar tipo do usuário ${userId}:`, error);
                return null;
            }
        };

        const denuncianteInfoEl = document.getElementById('denunciante-info');
        denuncianteInfoEl.innerHTML = '<p><strong>Denunciante:</strong> Carregando...</p>';
        if (denuncia.anonimo) {
            denuncianteInfoEl.innerHTML = `<p><strong>Denunciante:</strong> Anônimo</p>`;
        } else if (denuncia.denunciante_id) {
            const userType = await getUserType(denuncia.denunciante_id);
            let denuncianteHtml = `<p><strong>Denunciante:</strong> ${denuncia.denunciante_nome || 'Usuário não encontrado'} (Tipo: ${userType || 'N/A'})`;
            if (userType === 'professor') {
                denuncianteHtml += ` (<a href="/exibir_prof/${denuncia.denunciante_id}" target="_blank">Ver Perfil</a>)`;
            }
            denuncianteHtml += `</p>`;
            denuncianteInfoEl.innerHTML = denuncianteHtml;
        }

        const denunciadoInfoEl = document.getElementById('denunciado-info');
        denunciadoInfoEl.innerHTML = '';
        if (denuncia.denunciado_id) {
            denunciadoInfoEl.innerHTML = '<p><strong>Denunciado:</strong> Carregando...</p>';
            const userType = await getUserType(denuncia.denunciado_id);
            let denunciadoHtml = `<p><strong>Denunciado:</strong> ${denuncia.denunciado_nome || 'Usuário não encontrado'} (Tipo: ${userType || 'N/A'})`;
            if (userType === 'professor') {
                denunciadoHtml += ` (<a href="/exibir_prof/${denuncia.denunciado_id}" target="_blank">Ver Perfil</a>)`;
            }
            denunciadoHtml += `</p>`;
            denunciadoInfoEl.innerHTML = denunciadoHtml;
        }

        const conteudoInfoEl = document.getElementById('conteudo-info');
        if (denuncia.conteudo_info) {
            try {
                const info = typeof denuncia.conteudo_info === 'string' ? JSON.parse(denuncia.conteudo_info) : denuncia.conteudo_info;
                let link = '';
                if (info.tipo === 'comentario' && denuncia.professor_id) {
                    link = `<a href="/exibir_prof/${denuncia.professor_id}#comentario-${info.id}" target="_blank">Ver comentário</a>`;
                } else if (info.tipo === 'perfil' && denuncia.denunciado_id) {
                    link = `<a href="/exibir_prof/${denuncia.denunciado_id}" target="_blank">Ver perfil denunciado</a>`;
                }
                conteudoInfoEl.innerHTML = `<p><strong>Contexto:</strong> ${info.tipo} (ID: ${info.id}) ${link}</p>`;
                if (info.tipo === 'comentario') {
                    document.getElementById('modal-item-denunciado').innerText = 'Comentário';
                    const commentContentEl = document.getElementById('modal-comment-content');
                    if (denuncia.comentario_texto) {
                        commentContentEl.innerText = denuncia.comentario_texto;
                        commentContentEl.style.display = 'block';
                    } else {
                        commentContentEl.style.display = 'none';
                    }
                } else {
                    document.getElementById('modal-comment-content').style.display = 'none';
                    if (info.tipo === 'perfil') document.getElementById('modal-item-denunciado').innerText = 'Perfil';
                }
            } catch(e) { console.error('Erro ao parsear conteudo_info:', e); conteudoInfoEl.innerHTML = ''; }
        } else {
            conteudoInfoEl.innerHTML = '';
        }

        const evidenciaInfoEl = document.getElementById('evidencia-info');
        const evidenciaParts = [];
        if (denuncia.evidencia) {
            evidenciaParts.push(`<p><strong>Evidência (link):</strong> <a href="${denuncia.evidencia}" target="_blank" rel="noopener noreferrer">Abrir link</a></p>`);
        }
        if (denuncia.evidencia_arquivo) {
            const fileUrl = `/denuncia/evidencia/${denuncia.id}`;
            const isImage = /\.(jpg|jpeg|png|webp|gif)$/i.test(denuncia.evidencia_arquivo);
            const isVideo = /\.(mp4|webm|mov)$/i.test(denuncia.evidencia_arquivo);
            if (isImage) {
                evidenciaParts.push(`<p><strong>Evidência (arquivo):</strong></p><p><a href="${fileUrl}" target="_blank" rel="noopener noreferrer"><img src="${fileUrl}" alt="Evidência da denúncia" style="max-width:320px; max-height:240px; border-radius:8px; border:1px solid #ddd;"></a></p>`);
            } else if (isVideo) {
                evidenciaParts.push(`<p><strong>Evidência (arquivo):</strong></p><video src="${fileUrl}" controls style="max-width:320px; max-height:240px; border-radius:8px; border:1px solid #ddd;"></video><p><a href="${fileUrl}" target="_blank" rel="noopener noreferrer">Abrir arquivo</a></p>`);
            } else {
                evidenciaParts.push(`<p><strong>Evidência (arquivo):</strong> <a href="${fileUrl}" target="_blank" rel="noopener noreferrer">Abrir arquivo</a></p>`);
            }
        }
        evidenciaInfoEl.innerHTML = evidenciaParts.join('');

        const historicoListaEl = document.getElementById('historico-lista');
        historicoListaEl.innerHTML = '<li>Carregando histórico...</li>';
        try {
            const histRes = await fetch(`/admin/denuncias/${denuncia.id}/historico`);
            if (!histRes.ok) {
                const errorText = await histRes.text();
                console.error('Falha ao buscar histórico da denúncia:', histRes.status, errorText);
                throw new Error(`Servidor respondeu com status ${histRes.status}`);
            }
            const historico = await histRes.json();
            if (Array.isArray(historico) && historico.length > 0) {
                historicoListaEl.innerHTML = historico.map(h => {
                    const dataAcao = h.criado_em ? new Date(h.criado_em).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }) : 'data indisponível';
                    return `<li><strong>${h.acao || 'Ação desconhecida'}</strong> por ${h.usuario_nome || 'Sistema'} em ${dataAcao}: <em>${h.detalhes || '(sem detalhes)'}</em></li>`;
                }).join('');
            } else {
                historicoListaEl.innerHTML = '<li>Nenhuma ação registrada.</li>';
            }
        } catch(e) {
            console.error('Erro ao processar o histórico da denúncia:', e);
            historicoListaEl.innerHTML = '<li>Erro ao carregar histórico. Verifique o console para mais detalhes.</li>';
        }

        const actionsFormEl = document.getElementById('denuncia-actions-form');
        const feedbackEl = document.getElementById('denuncia-action-feedback');
        const setFeedback = (msg, ok) => {
            if (!feedbackEl) return;
            feedbackEl.textContent = msg || '';
            feedbackEl.style.color = ok ? '#15803d' : '#b91c1c';
        };
        const refreshDenunciaHistorico = async () => {
            const historicoListaEl = document.getElementById('historico-lista');
            try {
                const histRes = await fetch(`/admin/denuncias/${denuncia.id}/historico`, { headers: { 'Accept': 'application/json' } });
                if (!histRes.ok) throw new Error('Falha ao carregar histórico');
                const historico = await histRes.json();
                if (Array.isArray(historico) && historico.length > 0) {
                    historicoListaEl.innerHTML = historico.map(h => {
                        const dataAcao = h.criado_em ? new Date(h.criado_em).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }) : 'data indisponível';
                        return `<li><strong>${h.acao || 'Ação desconhecida'}</strong> por ${h.usuario_nome || 'Sistema'} em ${dataAcao}: <em>${h.detalhes || '(sem detalhes)'}</em></li>`;
                    }).join('');
                } else {
                    historicoListaEl.innerHTML = '<li>Nenhuma ação registrada.</li>';
                }
            } catch (e) {
                historicoListaEl.innerHTML = '<li>Erro ao carregar histórico.</li>';
            }
        };
        const updateStatusUI = (newStatus) => {
            if (!newStatus) return;
            denuncia.status = newStatus;
            const statusEl = document.getElementById('modal-status');
            if (statusEl) {
                statusEl.innerText = newStatus;
                statusEl.className = `status-badge status-${String(newStatus).toLowerCase().replace(/ /g, '-')}`;
            }
            const sel = actionsFormEl.querySelector('select[name="status"]');
            if (sel) sel.value = newStatus;
            document.querySelectorAll('.data-table tbody tr').forEach(tr => {
                const first = tr.querySelector('td');
                if (first && first.textContent.trim() === ('#' + denuncia.id)) {
                    const badge = tr.querySelector('.status-badge');
                    if (badge) {
                        badge.innerText = newStatus;
                        badge.className = `status-badge status-${String(newStatus).toLowerCase().replace(/ /g, '-')}`;
                    }
                }
            });
        };
        setFeedback('', true);
        actionsFormEl.innerHTML = `
            <input type="hidden" name="denunciaId" value="${denuncia.id}">
            <input type="hidden" name="userId" value="${denuncia.denunciado_id || ''}">
            
            <section class="form-group-row">
                <section class="form-group">
                    <label>Mudar Status:</label>
                    <select name="status" class="select">
                        <option value="aberta" ${denuncia.status === 'aberta' ? 'selected' : ''}>Aberta</option>
                        <option value="em_analise" ${denuncia.status === 'em_analise' ? 'selected' : ''}>Em Análise</option>
                        <option value="resolvida" ${denuncia.status === 'resolvida' ? 'selected' : ''}>Resolvida</option>
                        <option value="rejeitada" ${denuncia.status === 'rejeitada' ? 'selected' : ''}>Rejeitada</option>
                    </select>
                </section>
                <button type="button" data-action="status" data-url="/admin/denuncias/${denuncia.id}/status" class="btn btn-primary">Atualizar</button>
            </section>
            <hr>
            <section class="form-group">
                <label>Advertir Usuário:</label>
                <textarea name="message" placeholder="Mensagem de advertência para o usuário..."></textarea>
                <button type="button" data-action="warn" data-url="/admin/denuncias/${denuncia.id}/warn" class="btn btn-warning">Advertir</button>
            </section>
            <hr>
            <section class="form-group">
                <label>Suspender Usuário:</label>
                <input type="number" name="duration" placeholder="Dias de suspensão (ex: 7)" min="1">
                <textarea name="reason" placeholder="Motivo da suspensão para o usuário..."></textarea>
                <button type="button" data-action="suspend" data-url="/admin/denuncias/${denuncia.id}/suspend" class="btn btn-danger">Suspender</button>
            </section>
            <hr>
            <section class="form-group">
                <label>Banir Usuário:</label>
                <textarea name="reasonBan" placeholder="Motivo do banimento para o usuário..."></textarea>
                <button type="button" data-action="ban" data-url="/admin/denuncias/${denuncia.id}/ban" class="btn btn-danger">Banir Permanentemente</button>
            </section>
             <hr>
            <section class="form-group">
                <label>Adicionar Observação Interna:</label>
                <textarea name="note" placeholder="Observação visível apenas para admins..."></textarea>
                <button type="button" data-action="note" data-url="/admin/denuncias/${denuncia.id}/note" class="btn btn-primary">Salvar Nota</button>
            </section>
        `;
        if (denuncia.conteudo_info) {
            try {
                const info = typeof denuncia.conteudo_info === 'string' ? JSON.parse(denuncia.conteudo_info) : denuncia.conteudo_info;
                if (info && info.tipo === 'comentario') {
                    actionsFormEl.insertAdjacentHTML('beforeend', `<hr><section class="form-group" id="delete-comment-group"><label>Conteúdo denunciado:</label><button type="button" data-action="delete-comment" data-url="/admin/denuncias/${denuncia.id}/delete-comment" class="btn btn-danger">Excluir Comentário</button></section>`);
                }
            } catch (_) {}
        }

        actionsFormEl.onsubmit = (e) => e.preventDefault();
        actionsFormEl.onclick = async (e) => {
            const btn = e.target.closest('button[data-action]');
            if (!btn) return;
            const action = btn.dataset.action;
            const url = btn.dataset.url;
            if (!url) return;
            e.preventDefault();
            const original = btn.textContent;
            btn.disabled = true;
            btn.textContent = 'Processando...';
            setFeedback('', true);
            try {
                const formData = new FormData(actionsFormEl);
                const body = new URLSearchParams(formData);
                const res = await fetch(url, {
                    method: 'POST',
                    headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
                    body
                });
                let data = {};
                try { data = await res.json(); } catch (_) {}
                if (!res.ok || data.success === false) {
                    throw new Error((data && data.message) || ('Falha ao executar ação (' + res.status + ').'));
                }
                setFeedback(data.message || 'Ação realizada com sucesso.', true);
                if (action === 'status') {
                    updateStatusUI(formData.get('status'));
                } else if (action === 'warn') {
                    const ta = actionsFormEl.querySelector('textarea[name="message"]'); if (ta) ta.value = '';
                } else if (action === 'suspend') {
                    const d = actionsFormEl.querySelector('input[name="duration"]'); if (d) d.value = '';
                    const r = actionsFormEl.querySelector('textarea[name="reason"]'); if (r) r.value = '';
                } else if (action === 'ban') {
                    const r = actionsFormEl.querySelector('textarea[name="reasonBan"]'); if (r) r.value = '';
                } else if (action === 'note') {
                    const n = actionsFormEl.querySelector('textarea[name="note"]'); if (n) n.value = '';
                } else if (action === 'delete-comment') {
                    const grp = document.getElementById('delete-comment-group'); if (grp) grp.remove(); else btn.closest('.form-group')?.remove();
                }
                await refreshDenunciaHistorico();
            } catch (err) {
                setFeedback(err.message || 'Erro ao executar ação.', false);
            } finally {
                if (document.body.contains(btn)) {
                    btn.disabled = false;
                    btn.textContent = original;
                }
            }
        };

        const modal = document.getElementById('denuncia-modal');
        modal.style.display = 'block';

        const closeButton = document.querySelector('#denuncia-modal .close-button');
        closeButton.onclick = function() { modal.style.display = 'none'; }

        window.onclick = function(event) {
            if (event.target == modal) { modal.style.display = 'none'; }
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
      const menuBtn = document.getElementById('menu-btn');
      const menu = document.getElementById('menu');
      const overlay = document.getElementById('overlay');
      const closeBtn = document.getElementById('close-menu');
      const toggleBtn = document.getElementById('toggle-menu');
      const toggleIcon = document.getElementById('toggle-icon');
      const navLinks = document.querySelectorAll('.admin-nav-link');
      const pages = document.querySelectorAll('.content-page');
      const pageTitle = document.getElementById('page-title');

      const toggleMobileMenu = () => {
        menu.classList.toggle('active');
        overlay.classList.toggle('active');
        document.body.classList.toggle('no-scroll', menu.classList.contains('active'));
      };
      [menuBtn, overlay, closeBtn].forEach(el => el?.addEventListener('click', toggleMobileMenu));

      if (toggleBtn) {
        const isCollapsed = localStorage.getItem('adminMenuCollapsed') === 'true';
        if (isCollapsed) {
          menu.classList.add('collapsed');
          toggleIcon.style.transform = 'rotate(180deg)';
        }
        toggleBtn.addEventListener('click', () => {
          menu.classList.toggle('collapsed');
          const collapsed = menu.classList.contains('collapsed');
          toggleIcon.style.transform = collapsed ? 'rotate(180deg)' : 'rotate(0deg)';
          localStorage.setItem('adminMenuCollapsed', collapsed);
        });
      }

      let showPage = (targetId) => {
        pages.forEach(p => p.classList.toggle('active', p.id === targetId.substring(1)));
        navLinks.forEach(l => {
          const active = l.getAttribute('href') === targetId;
          l.classList.toggle('active', active);
          if (active && pageTitle) pageTitle.textContent = l.querySelector('.label').textContent;
        });
        if (window.location.hash !== targetId) {
            window.history.pushState(null, '', targetId);
        }

        if (targetId === '#page-finance') {
            fetchPendingPayouts();
            fetchTransactionHistory();
        }
      };

      navLinks.forEach(link => {
        link.addEventListener('click', e => {
          const target = link.getAttribute('href');
          if (target.startsWith('/')) return;
          e.preventDefault();
          showPage(target);
          if (window.innerWidth < 768) toggleMobileMenu();
        });
      });

      const formatCurrency = (value) => {
          return new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(value);
      };

      const fetchDashboardData = async () => {
          try {
              const response = await fetch('/admin/dashboard/summary');
              if (!response.ok) throw new Error('Failed to load dashboard data');
              const data = await response.json();

              document.getElementById('kpi-revenue').textContent = formatCurrency(data.monthlyRevenue);
              document.getElementById('kpi-pending-payments').textContent = formatCurrency(data.pendingPayments);
              document.getElementById('kpi-new-students').textContent = data.newStudents;
              document.getElementById('kpi-completed-classes').textContent = data.completedClasses;
              document.getElementById('kpi-open-reports').textContent = <%=openReports%>;
              
              const openReportsBadge = document.getElementById('open-reports-badge');
              if(openReportsBadge) openReportsBadge.textContent = <%=openReports%>;

               const activityList = document.getElementById('recent-activity-list');
              if(activityList && data.recentActivities){
                activityList.innerHTML = data.recentActivities.map(act => `<li><i class="${act.icon}" style="color: ${act.color};"></i> ${act.message}</li>`).join('')
              }

          } catch (error) {
              console.error('Error updating KPIs:', error);
              document.querySelectorAll('.kpi-value').forEach(el => el.textContent = "Erro");
          }
      };

      const fetchPendingPayouts = async () => {
        const tableBody = document.querySelector('#pending-payouts-table tbody');
        try {
            const response = await fetch('/admin/financeiro/repasses');
            if (!response.ok) throw new Error('Falha ao carregar repasses');
            const payouts = await response.json();

            tableBody.innerHTML = ''; // Limpa a tabela
            if (payouts.length > 0) {
                payouts.forEach(payout => {
                    const row = document.createElement('tr');
                    row.innerHTML = `
                        <td>${payout.professor_nome}</td>
                        <td>${formatCurrency(payout.valor)}</td>
                        <td>${payout.status === 'retido' ? 'Aguardando realização da aula' : 'Disponível para repasse'}</td>
                        <td>${new Date(payout.data_solicitacao).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' })}</td>
                        <td class="actions-buttons">
                            ${payout.status === 'pendente'
                                ? `<button type="button" class="btn btn-success" data-payout-id="${payout.id}">Registrar pagamento</button>`
                                : '—'}
                        </td>
                    `;
                    tableBody.appendChild(row);
                });
            } else {
                tableBody.innerHTML = '<tr><td colspan="5">Nenhum repasse pendente.</td></tr>';
            }
        } catch (error) {
            console.error('Error fetching pending payouts:', error);
            tableBody.innerHTML = '<tr><td colspan="5">Erro ao carregar repasses.</td></tr>';
        }
    };

    const fetchTransactionHistory = async (page = 1) => {
        const tableBody = document.querySelector('#transaction-history-table tbody');
        const paginationContainer = document.getElementById('transaction-pagination');
        try {
            const response = await fetch(`/admin/financeiro/transactions?page=${page}&limit=15`);
            const { transactions, pagination } = await response.json();

            tableBody.innerHTML = '';
            if (transactions.length > 0) {
                transactions.forEach(tx => {
                    const row = document.createElement('tr');
                    row.innerHTML = `
                        <td>${tx.pagamento_id}</td>
                        <td>${tx.descricao}</td>
                        <td>${formatCurrency(tx.valor)}</td>
                        <td>${formatCurrency(tx.taxa_plataforma)}</td>
                        <td>${formatCurrency(tx.valor_liquido)}</td>
                        <td><output class="status-badge status-${tx.status}">${tx.status}</output></td>
                        <td>${new Date(tx.criado_em).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' })}</td>
                        <td>${tx.aluno_nome || 'N/A'}</td>
                        <td>${tx.professor_nome || 'N/A'}</td>
                    `;
                    tableBody.appendChild(row);
                });
            } else {
                tableBody.innerHTML = '<tr><td colspan="9">Nenhuma transação encontrada.</td></tr>';
            }

            // Paginação
            paginationContainer.innerHTML = '';
            if (pagination.totalPages > 1) {
                const ul = document.createElement('ul');

                if (pagination.page > 1) {
                    const prevLi = document.createElement('li');
                    const prevA = document.createElement('a');
                    prevA.href = '#';
                    prevA.textContent = 'Anterior';
                    prevA.onclick = (e) => { e.preventDefault(); fetchTransactionHistory(pagination.page - 1); };
                    prevLi.appendChild(prevA);
                    ul.appendChild(prevLi);
                }

                for (let i = 1; i <= pagination.totalPages; i++) {
                    const li = document.createElement('li');
                    if (i === pagination.page) li.className = 'active';
                    const a = document.createElement('a');
                    a.href = '#';
                    a.textContent = i;
                    a.onclick = (e) => { e.preventDefault(); fetchTransactionHistory(i); };
                    li.appendChild(a);
                    ul.appendChild(li);
                }

                if (pagination.page < pagination.totalPages) {
                    const nextLi = document.createElement('li');
                    const nextA = document.createElement('a');
                    nextA.href = '#';
                    nextA.textContent = 'Próximo';
                    nextA.onclick = (e) => { e.preventDefault(); fetchTransactionHistory(pagination.page + 1); };
                    nextLi.appendChild(nextA);
                    ul.appendChild(nextLi);
                }
                paginationContainer.appendChild(ul);
            }

        } catch (error) {
            console.error('Error fetching transaction history:', error);
            tableBody.innerHTML = '<tr><td colspan="7">Erro ao carregar transações.</td></tr>';
        }
    };

    const markAsPaid = async (payoutId) => {
        const result = await Swal.fire({
            title: 'Registrar pagamento realizado',
            text: 'Confirme somente se o valor já foi transferido ao professor. Esta ação registra o pagamento no sistema, mas não movimenta dinheiro.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Confirmar pagamento realizado',
            cancelButtonText: 'Não',
            reverseButtons: true
        });
        if (!result.isConfirmed) {
            return;
        }

        try {
            const response = await fetch(`/admin/financeiro/repasses/${payoutId}/paid`, {
                method: 'POST',
            });

            if (response.ok) {
                Swal.fire("Repasse marcado como pago com sucesso!");
                fetchPendingPayouts(); // Atualiza a tabela
            } else {
                const errorText = await response.text();
                Swal.fire(`Erro ao marcar como pago: ${errorText}`);
            }
        } catch (error) {
            console.error('Error marking payout as paid:', error);
            Swal.fire("Ocorreu um erro na comunicação com o servidor.");
        }
    };

    document.querySelector('#pending-payouts-table tbody').addEventListener('click', event => {
        const button = event.target.closest('button[data-payout-id]');
        if (button) markAsPaid(button.dataset.payoutId);
    });

    // --- Cadastro de Administradores (superadmin) ---
    const createAdminForm = document.getElementById('create-admin-form');
    if (createAdminForm) {
        createAdminForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const feedback = document.getElementById('create-admin-feedback');
            const email = (document.getElementById('new-admin-email')?.value || '').trim();
            const senha = document.getElementById('new-admin-password')?.value || '';
            const role = document.getElementById('new-admin-role')?.value || 'admin';
            const submitBtn = createAdminForm.querySelector('button[type="submit"]');
            if (feedback) { feedback.textContent = ''; feedback.style.color = ''; }
            if (submitBtn) { submitBtn.disabled = true; }
            try {
                const response = await fetch('/admin/admins', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ email, senha, role })
                });
                let data = {};
                try { data = await response.json(); } catch (_) {}
                if (!response.ok || data.success === false) {
                    throw new Error(data.message || ('Falha ao cadastrar (' + response.status + ').'));
                }
                if (feedback) { feedback.style.color = '#15803d'; feedback.textContent = data.message || 'Administrador cadastrado com sucesso.'; }
                createAdminForm.reset();
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ title: 'Sucesso', text: data.message || 'Administrador cadastrado com sucesso.', icon: 'success', timer: 2000, showConfirmButton: false });
                }
            } catch (error) {
                if (feedback) { feedback.style.color = '#b91c1c'; feedback.textContent = error.message || 'Erro ao cadastrar administrador.'; }
                if (typeof Swal !== 'undefined') {
                    Swal.fire('Erro', error.message || 'Erro ao cadastrar administrador.', 'error');
                }
            } finally {
                if (submitBtn) { submitBtn.disabled = false; }
            }
        });
    }

      const currentHash = window.location.hash || '#page-users';
      if (currentHash && document.querySelector(currentHash)) {
          showPage(currentHash);
      } else {
          showPage('#page-dashboard');
      }
      fetchDashboardData();
    });
  </script>
</body>
</html>