<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Chat com <%= interlocutorName %> | Regimath</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/css/chat.css">
    <link rel="stylesheet" href="../css/accessibility.css">
    <link rel="icon" href="/imagens/Regimath_sem fundo cor preto2.png"/>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  </head>

<body>
    <li class="a11y-fab pa" style="display: none; position: absolute; visibility: hidden; z-index: -99; top: -260px;"><button id="a11y-open-modal" aria-label="Abrir painel de acessibilidade"><i class="fas fa-universal-access"></i>Acessibilidade</button></li>
    <header class="chat-header">
        <section class="chat-header-content">
            <a onclick="history.back()" class="btn-back" aria-label="Voltar">
                <i class="fas fa-arrow-left"></i>
            </a><br>
            <h3>Conversa com <%= interlocutorName %></h3>
        </section>
        <a href="/video/<%= room %>" class="btn-video" aria-label="Acessar Sala de Vídeo">
            <i class="fas fa-video"></i>
        </a>
    </header>

    <% if (user && user.tipo === 'professor') { %>
        <section class="payment-request-ui is-collapsed" id="paymentRequestUi">
            <button type="button" class="payment-toggle" id="paymentToggle" aria-expanded="false" aria-controls="paymentRequestBody">
                <span><i class="fas fa-calendar-check"></i> Agendar aula pelo chat</span>
                <i class="fas fa-chevron-down payment-toggle-icon" aria-hidden="true"></i>
            </button>
            <div class="payment-request-body" id="paymentRequestBody">
                <select id="payHorario" class="ui-input desc-input" aria-label="Horário disponível">
                    <option value="">Selecione um horário disponível</option>
                    <% (horariosDisponiveis || []).forEach(h => { %>
                        <option value="<%= h.id %>" data-preco="<%= h.preco %>" data-data="<%= h.data %>" data-inicio="<%= h.hora_inicio %>" data-fim="<%= h.hora_fim %>">
                            <%= h.data.split('-').reverse().join('/') %> <%= h.hora_inicio %>-<%= h.hora_fim %> - R$ <%= Number(h.preco).toFixed(2).replace('.', ',') %>
                        </option>
                    <% }) %>
                </select>
                <input id="payDescricao" type="hidden" maxlength="80" />
                <input id="payValor" class="ui-input value-input" type="text" inputmode="decimal" placeholder="Valor" readonly />
                <button id="sendPaymentReq" class="btn-billing btn-primary" disabled>Cobrar</button>
                <% if (!horariosDisponiveis || horariosDisponiveis.length === 0) { %>
                    <p class="payment-empty-note">Sem horários disponíveis. Cadastre horários no seu perfil.</p>
                <% } %>
            </div>
        </section>
    <% } %>

    <main class="chat-main" id="chatBody"></main>

    <form id="chatForm" class="chat-form">
        <input id="chatMessage" type="text" placeholder="Digite sua mensagem..." autocomplete="off" required>
        <button type="submit" aria-label="Enviar mensagem">
            <i class="fas fa-paper-plane"></i>
        </button>
    </form>

    <script src="../js/accessibility.js"></script>
    <script>
        const CHAT_USER_DATA = JSON.parse('<%- JSON.stringify(user || {}) %>');
        const CHAT_USER = {
            id: CHAT_USER_DATA.id,
            nome: CHAT_USER_DATA.nome || 'Visitante',
        };
        const CHAT_ROOM = "<%= room %>";
        const CHAT_PARTNER = JSON.parse('<%- JSON.stringify(partner || {}) %>');
        const CHAT_HORARIOS = JSON.parse('<%- JSON.stringify(horariosDisponiveis || []) %>');
    </script>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        (function () {
            const socket = io();
            const chatBody = document.getElementById('chatBody');
            const chatForm = document.getElementById('chatForm');
            const chatInput = document.getElementById('chatMessage');
            
            const sendPaymentBtn = document.getElementById('sendPaymentReq');
            const payDescInput = document.getElementById('payDescricao');
            const payValorInput = document.getElementById('payValor');
            const payHorarioSelect = document.getElementById('payHorario');
            const paymentToggle = document.getElementById('paymentToggle');
            const paymentRequestUi = document.getElementById('paymentRequestUi');

            const scrollToBottom = () => {
                chatBody.scrollTop = chatBody.scrollHeight;
            };

            const formatCurrencyInput = (input) => {
                let value = input.value.replace(/\D/g, '');
                if (value.length > 2) {
                    value = value.replace(/(\d{2})$/, ',$1');
                    if (value.length > 6) {
                        value = value.replace(/(\d+)(\d{3},\d{2})$/, '$1.$2');
                    }
                } else if (value.length === 1) {
                    value = '0,0' + value;
                } else if (value.length === 2) {
                    value = '0,' + value;
                }
                input.value = value;
            };

            const syncPaymentMode = () => {
                if (!payHorarioSelect) return;
                const opt = payHorarioSelect.options[payHorarioSelect.selectedIndex];
                if (opt && opt.value) {
                    const preco = Number(opt.dataset.preco || 0);
                    const data = opt.dataset.data || '';
                    const ini = opt.dataset.inicio || '';
                    const fim = opt.dataset.fim || '';
                    payValorInput.value = preco.toFixed(2).replace('.', ',');
                    payDescInput.value = `Aula agendada - ${data.split('-').reverse().join('/')} ${ini}-${fim}`;
                } else {
                    payValorInput.value = '';
                    payDescInput.value = '';
                }
                checkPaymentInputs();
            };

            const checkPaymentInputs = () => {
                if (!sendPaymentBtn) return;
                const horarioId = payHorarioSelect ? payHorarioSelect.value : '';
                const valor = payValorInput.value.replace(/\./g, '').replace(',', '.').replace(/[^\d.]/g, '');
                const ok = !!horarioId && parseFloat(valor) > 0;
                if (ok) sendPaymentBtn.removeAttribute('disabled');
                else sendPaymentBtn.setAttribute('disabled', 'disabled');
            };

            if (paymentToggle && paymentRequestUi) {
                paymentToggle.addEventListener('click', () => {
                    const collapsed = paymentRequestUi.classList.toggle('is-collapsed');
                    paymentToggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
                });
            }

            if (payHorarioSelect) payHorarioSelect.addEventListener('change', syncPaymentMode);
            syncPaymentMode();

            function createMsg(msg) {
                const isSent = msg.user.id === CHAT_USER.id;
                const section = document.createElement('section');
                section.classList.add('message', isSent ? 'sent' : 'received');

                if (!isSent) {
                    const user = document.createElement('p');
                    user.classList.add('msg-user');
                    user.textContent = msg.user.nome;
                    section.appendChild(user);
                }

                const text = document.createElement('p');
                text.classList.add('msg-text');
                text.textContent = msg.text;

                const time = document.createElement('p');
                time.classList.add('msg-time');
                time.textContent = new Date(msg.time).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

                section.appendChild(text);
                section.appendChild(time);
                return section;
            }

            function createPaymentCard(data) {
                const wrap = document.createElement('section');
                const isSent = String(data.remetenteId) === String(CHAT_USER.id);
                const valorFormatado = Number(data.valor).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
                const isLesson = !!data.horarioId;
                const title = isLesson ? 'Solicitação de Agendamento' : 'Solicitação de Pagamento';
                const icon = isLesson ? 'fa-calendar-check' : 'fa-handshake';
                const note = isLesson ? 'Ao pagar, a aula será agendada automaticamente.' : 'Checkout seguro do Mercado Pago.';

                wrap.className = `message payment-card ${isSent ? 'sent' : 'received'}`;
                wrap.innerHTML = `
                    <section class="payment-header">
                        <i class="fas ${icon} payment-icon"></i>
                        <strong class="payment-title">${title}</strong>
                        <p class="payment-user">${isSent ? 'Você enviou:' : (data.remetente || 'Professor') + ' enviou:'}</p>
                    </section>
                    <section class="payment-details">
                        <section class="payment-desc">${data.descricao || 'Pagamento de Serviço'}</section>
                        <section class="payment-value">${valorFormatado}</section>
                    </section>
                    ${!isSent ? `
                        <a href="${data.link || '#'}" target="_blank" rel="noopener noreferrer" class="btn-pagar btn-success">
                            <i class="fas fa-wallet"></i> ${isLesson ? 'Pagar e Agendar' : 'Pagar Agora'}
                        </a>
                        <small class="payment-note">${note}</small>
                    ` : '<small class="payment-note sent-note">Link de pagamento criado.</small>'}
                `;
                return wrap;
            }

            socket.on("roomHistory", (history) => {
                chatBody.innerHTML = "";
                history.forEach(m => {
                    if (m.type === 'payment') {
                        chatBody.appendChild(createPaymentCard(m.data));
                    } else {
                        chatBody.appendChild(createMsg(m));
                    }
                });
                scrollToBottom();
            });

            socket.on("newMessage", (msg) => {
                chatBody.appendChild(createMsg(msg));
                scrollToBottom();
            });

            socket.on("systemMessage", (msg) => {
                const sys = document.createElement("section");
                sys.classList.add("system-msg");
                sys.textContent = msg.text;
                chatBody.appendChild(sys);
                scrollToBottom();
            });

            socket.emit("joinRoom", { room: CHAT_ROOM });

            chatForm.addEventListener("submit", e => {
                e.preventDefault();
                const text = chatInput.value.trim();
                if (!text) return;
                socket.emit("chatMessage", { room: CHAT_ROOM, text: text });
                chatInput.value = "";
            });

            socket.on('paymentRequest', (data) => {
                data.remetente = data.remetente || 'Professor'; 
                chatBody.appendChild(createPaymentCard(data));
                scrollToBottom();
            });

            socket.on('paymentConfirmed', (info) => {
                const section = document.createElement('section');
                section.className = 'system-msg success-msg'; 
                const amt = Number(info.amount || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
                section.innerHTML = `✅ **Pagamento de ${amt} confirmado!** (${info.payer || 'Pagador desconhecido'})`;
                chatBody.appendChild(section);
                scrollToBottom();
            });

            if (sendPaymentBtn) {
                sendPaymentBtn.addEventListener('click', () => {
                    const horarioId = payHorarioSelect ? payHorarioSelect.value : '';
                    const desc = payDescInput.value.trim() || 'Aula agendada';
                    const valor = parseFloat(payValorInput.value.replace(/\./g, '').replace(',', '.')) || 0;
                    if (!horarioId) {
                        Swal.fire("Selecione um horário disponível.");
                        return;
                    }
                    if (!valor || valor <= 0) {
                        Swal.fire("Horário com valor inválido.");
                        return;
                    }
                    socket.emit('requestPayment', {
                        room: CHAT_ROOM,
                        valor: valor.toFixed(2),
                        descricao: desc,
                        horarioId,
                        createdBy: CHAT_USER.nome,
                        remetenteId: CHAT_USER.id
                    });
                    if (payHorarioSelect) payHorarioSelect.value = '';
                    payDescInput.value = '';
                    payValorInput.value = '';
                    syncPaymentMode();
                });
            }
        })();
    </script>
</body>
</html>
