  <main class="notif-page main-content-wrapper">
    <section class="notif-header">
      <h1><i class="fas fa-bell"></i> Minhas Notificações <span id="unread-badge" class="badge-unread" style="<%= naoLidas ? '' : 'display:none;' %>"><%= naoLidas %></span></h1>
      <div class="notif-actions">
        <button class="notif-btn secondary" id="btn-mark-all"><i class="fas fa-check-double"></i> Marcar todas como lidas</button>
        <a class="notif-btn primary" href="<%= session.user_aluno ? '/agenda' : '/aulas' %>"><i class="fas fa-arrow-left"></i> Voltar</a>
      </div>
    </section>

    <div class="notif-filters" id="notif-filters">
      <button class="filter-chip active" data-filter="all">Todas</button>
      <button class="filter-chip" data-filter="unread">Não lidas</button>
      <button class="filter-chip" data-filter="resolved">Resolvidas</button>
      <!-- <% Object.keys(tipos || {}).forEach(k => { %>
        <button class="filter-chip" data-filter="type:<%= k %>"><%= tipos[k].label %></button>
      <% }) %>-->
    </div>

    <div class="notif-list" id="notif-list">
      <% if (!notificacoes || notificacoes.length === 0) { %>
        <div class="notif-empty"><i class="fas fa-bell-slash"></i><p>Nenhuma notificação por enquanto.</p></div>
      <% } %>
      <% (notificacoes || []).forEach(n => { const meta = n.meta || {label:n.tipo, icon:'fa-bell', cor:'#800020'}; %>
        <article class="notif-card <%= n.lida ? 'lida' : '' %> <%= n.resolvida ? 'resolvida' : '' %>" data-id="<%= n.id %>" data-type="<%= n.tipo %>" data-read="<%= n.lida ? '1' : '0' %>" data-resolved="<%= n.resolvida ? '1' : '0' %>">
          <div class="notif-icon" style="background:<%= meta.cor %>"><i class="fas <%= meta.icon %>"></i></div>
          <div class="notif-body">
            <div class="notif-meta">
              <span class="notif-type" style="color:<%= meta.cor %>"><%= meta.label %></span>
              <span>•</span>
              <span><%= n.criado_em ? new Date(n.criado_em).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }) : '' %></span>
              <% if (n.resolvida) { %><span>• Resolvida</span><% } else if (!n.lida) { %><span>• Nova</span><% } %>
            </div>
            <p class="notif-msg"><%= n.mensagem %></p>
            <div class="notif-card-actions">
              <!-- <% if (n.link_relacionado) { %><a href="<%= n.link_relacionado %>"><i class="fas fa-external-link-alt"></i> Abrir</a><% } %>-->
              <% if (!n.lida) { %><button data-action="read"><i class="fas fa-check"></i> Marcar lida</button><% } %>
              <% if (!n.resolvida) { %><button data-action="resolve"><i class="fas fa-box-archive"></i> Resolver</button><% } %>
              <% if (n.resolvida) { %><button data-action="delete" class="danger"><i class="fas fa-trash"></i> Excluir</button><% } %>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  </main>

  <script src="/js/accessibility.js"></script>
  <script>
    const menuBtn = document.getElementById('menu-btn');
    const menu = document.getElementById('menu');
    const overlay = document.getElementById('overlay');
    const closeBtn = document.getElementById('close-menu');
    const toggleBtn = document.getElementById("toggle-menu");

    function toggleMobileMenu() {
      menu.classList.toggle('active');
      overlay.classList.toggle('active');
      document.body.classList.toggle('no-scroll', menu.classList.contains('active'));
    }

    if (menuBtn) menuBtn.addEventListener('click', toggleMobileMenu);
    if (overlay) overlay.addEventListener('click', toggleMobileMenu);
    if (closeBtn) closeBtn.addEventListener('click', toggleMobileMenu);

    if (toggleBtn) {
      const toggleIcon = document.getElementById('toggle-icon');
      const isCollapsed = menu.classList.contains('collapsed');
      toggleBtn.setAttribute('aria-expanded', isCollapsed ? 'false' : 'true');
      if (isCollapsed) toggleIcon.style.transform = 'rotate(180deg)';

      toggleBtn.addEventListener("click", (e) => {
        e.preventDefault();
        menu.classList.toggle("collapsed");
        const isNowCollapsed = menu.classList.contains('collapsed');
        toggleBtn.setAttribute('aria-expanded', isNowCollapsed ? 'false' : 'true');
        toggleIcon.style.transform = isNowCollapsed ? 'rotate(180deg)' : 'rotate(0deg)';
      });
    }

    const list = document.getElementById('notif-list');
    const badge = document.getElementById('unread-badge');
    function updateBadge(delta) {
      const current = parseInt(badge.textContent || '0', 10) || 0;
      const next = Math.max(0, current + delta);
      badge.textContent = next;
      badge.style.display = next > 0 ? '' : 'none';
    }
    function applyFilter(filter) {
      document.querySelectorAll('.filter-chip').forEach(c => c.classList.toggle('active', c.dataset.filter === filter));
      document.querySelectorAll('.notif-card').forEach(card => {
        const read = card.dataset.read === '1';
        const resolved = card.dataset.resolved === '1';
        const type = card.dataset.type;
        let show = true;
        if (filter === 'unread') show = !read && !resolved;
        else if (filter === 'resolved') show = resolved;
        else if (filter.startsWith('type:')) show = type === filter.slice(5);
        card.style.display = show ? '' : 'none';
      });
    }
    document.getElementById('notif-filters').addEventListener('click', (e) => {
      const chip = e.target.closest('.filter-chip');
      if (chip) applyFilter(chip.dataset.filter);
    });
    document.getElementById('btn-mark-all').addEventListener('click', async () => {
      const res = await fetch('/minhas-notificacoes/marcar-todas-lidas', { method: 'POST', headers: { 'Accept': 'application/json' } });
      if (res.ok) {
        document.querySelectorAll('.notif-card[data-read="0"][data-resolved="0"]').forEach(c => { c.dataset.read='1'; c.classList.add('lida'); c.querySelector('[data-action="read"]')?.remove(); });
        badge.textContent = '0'; badge.style.display = 'none';
      }
    });
    list.addEventListener('click', async (e) => {
      const btn = e.target.closest('button[data-action]');
      if (!btn) return;
      const card = btn.closest('.notif-card');
      const id = card.dataset.id;
      const action = btn.dataset.action;
      btn.disabled = true;
      try {
        if (action === 'read') {
          const res = await fetch(`/minhas-notificacoes/${id}/lida`, { method: 'POST', headers: { 'Accept': 'application/json' } });
          if (res.ok) { if (card.dataset.read === '0') updateBadge(-1); card.dataset.read='1'; card.classList.add('lida'); btn.remove(); }
        } else if (action === 'resolve') {
          const res = await fetch(`/minhas-notificacoes/${id}/resolver`, { method: 'POST', headers: { 'Accept': 'application/json' } });
          if (res.ok) { if (card.dataset.read === '0') updateBadge(-1); card.dataset.read='1'; card.dataset.resolved='1'; card.classList.add('lida','resolvida'); card.querySelector('[data-action="read"]')?.remove(); btn.outerHTML = '<button data-action="delete" class="danger"><i class="fas fa-trash"></i> Excluir</button>'; }
        } else if (action === 'delete') {
          const res = await fetch(`/minhas-notificacoes/${id}`, { method: 'DELETE', headers: { 'Accept': 'application/json' } });
          if (res.ok) { card.remove(); if (!list.querySelector('.notif-card')) list.innerHTML = '<div class="notif-empty"><i class="fas fa-bell-slash"></i><p>Nenhuma notificação por enquanto.</p></div>'; }
        }
      } finally { if (btn.isConnected) btn.disabled = false; }
    });

    // Socket.IO real-time
    try {
      const socketScript = document.createElement('script');
      socketScript.src = '/socket.io/socket.io.js';
      socketScript.onload = () => {
        const socket = io();
        socket.on('notification:new', (n) => {
          const meta = n.meta || {label:n.tipo, icon:'fa-bell', cor:'#800020'};
          const empty = list.querySelector('.notif-empty'); if (empty) empty.remove();
          const article = document.createElement('article');
          article.className = 'notif-card';
          article.dataset.id = n.id; article.dataset.type = n.tipo; article.dataset.read='0'; article.dataset.resolved='0';
          article.innerHTML = `<div class="notif-icon" style="background:${meta.cor}"><i class="fas ${meta.icon}"></i></div><div class="notif-body"><div class="notif-meta"><span class="notif-type" style="color:${meta.cor}">${meta.label}</span><span>•</span><span>${new Date(n.criado_em || Date.now()).toLocaleString('pt-BR',{timeZone:'America/Sao_Paulo'})}</span><span>• Nova</span></div><p class="notif-msg"></p><div class="notif-card-actions">${n.link_relacionado?`<a href="${n.link_relacionado}"><i class="fas fa-external-link-alt"></i> Abrir</a>`:''}<button data-action="read"><i class="fas fa-check"></i> Marcar lida</button><button data-action="resolve"><i class="fas fa-box-archive"></i> Resolver</button></div></div>`;
          article.querySelector('.notif-msg').textContent = n.mensagem || '';
          list.prepend(article);
          updateBadge(1);
        });
      };
      document.body.appendChild(socketScript);
    } catch (_) {}

  </script>
</body>
</html>
