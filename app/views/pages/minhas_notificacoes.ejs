<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/responsive.css">
  <title>Minhas Notificações - RegiMath</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/aulas.css" />
  <link rel="stylesheet" href="/css/accessibility.css">
  <link rel="icon" href="../imagens/Regimath_sem fundo cor preto2.png"/>
  <style>
    .notif-page { max-width: 920px; margin: 0 auto; padding: 24px 16px 48px; }
    .notif-header { display:flex; gap:12px; align-items:center; justify-content:space-between; flex-wrap:wrap; margin-bottom:20px; }
    .notif-header h1 { margin:0; font-size:1.8rem; color:#800020; }
    .notif-actions { display:flex; gap:8px; flex-wrap:wrap; }
    .notif-btn { border:none; border-radius:8px; padding:10px 14px; cursor:pointer; font-weight:600; font-family:inherit; }
    .notif-btn.primary { background:#800020; color:#fff; }
    .notif-btn.secondary { background:#eee; color:#333; }
    .notif-filters { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:18px; }
    .filter-chip { border:1px solid #d0d0d0; background:#fff; padding:8px 12px; border-radius:999px; cursor:pointer; font-size:.9rem; }
    .filter-chip.active { background:#800020; color:#fff; border-color:#800020; }
    .notif-list { display:flex; flex-direction:column; gap:12px; }
    .notif-card { background:#fff; border-radius:12px; padding:16px; box-shadow:0 4px 16px rgba(0,0,0,.08); display:flex; gap:14px; align-items:flex-start; border-left:5px solid #800020; }
    .notif-card.lida { opacity:.72; }
    .notif-card.resolvida { opacity:.55; border-left-color:#7f8c8d; }
    .notif-icon { width:42px; height:42px; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#fff; flex:0 0 42px; font-size:1rem; }
    .notif-body { flex:1; min-width:0; }
    .notif-meta { display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-bottom:4px; font-size:.82rem; color:#666; }
    .notif-type { font-weight:700; }
    .notif-msg { margin:0 0 10px; color:#2c3e50; line-height:1.5; word-break:break-word; }
    .notif-card-actions { display:flex; gap:8px; flex-wrap:wrap; }
    .notif-card-actions button, .notif-card-actions a { font-size:.82rem; padding:6px 10px; border-radius:6px; border:1px solid #ddd; background:#fff; cursor:pointer; text-decoration:none; color:#333; font-family:inherit; }
    .notif-card-actions .danger { color:#c0392b; border-color:#f0c7c2; }
    .notif-empty { text-align:center; padding:48px 16px; background:#fff; border-radius:12px; color:#666; box-shadow:0 4px 16px rgba(0,0,0,.06); }
    .notif-empty i { font-size:2.4rem; color:#bbb; display:block; margin-bottom:12px; }
    .badge-unread { background:#e74c3c; color:#fff; font-size:.75rem; padding:2px 8px; border-radius:999px; margin-left:6px; vertical-align:middle; }
    @media (max-width:640px){ .notif-header h1{font-size:1.45rem;} .notif-card{padding:14px;} }
  </style>
</head>
