<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recuperar Senha - Regimath</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="../css/cadastro.css">
    <link rel="icon" href="../imagens/Regimath_sem fundo cor preto2.png" />
</head>

<body>
    <header>
        <a href="/">
            <img src="/imagens/RM_bordo.png" alt="Regimath Logo" class="logo">
        </a>
    </header>

    <main>
        <form id="forgotPasswordForm" action="/forgot-password" method="POST" novalidate>
            <h2>Recuperação de Senha</h2>
            <p style="text-align: center; margin-bottom: 20px;">Insira seu e-mail de cadastro. Enviaremos um link com as instruções para você criar uma nova senha.</p>

            <section class="form-group">
                <label for="email"><i class="fas fa-envelope"></i> Email *</label>
                <input type="email" id="email" name="email" required autofocus>
                <p id="err-email" class="error-feedback" aria-live="polite"></p>
            </section>

            <button type="submit" class="btn-primary" id="btn-submit">
                <i class="fas fa-paper-plane"></i> Enviar Link de Redefinição
            </button>

            <section class="links-footer">
                <p><a href="/login" class="link-secundario">Lembrei minha senha</a></p>
                <p><a href="/" class="link-secundario">Voltar</a></p>
            </section>
        </form>
    </main>
    <script>
        (function() {
            const form = document.getElementById('forgotPasswordForm');
            const emailInput = document.getElementById('email');
            const emailError = document.getElementById('err-email');
            const submitButton = document.getElementById('btn-submit');

            function validateEmail() {
                const email = emailInput.value.trim();
                if (email === '') {
                    emailError.textContent = 'Este campo é obrigatório.';
                    emailInput.classList.add('invalid');
                    return false;
                } else if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
                    emailError.textContent = 'Por favor, insira um email válido.';
                    emailInput.classList.add('invalid');
                    return false;
                } else {
                    emailError.textContent = '';
                    emailInput.classList.remove('invalid');
                    emailInput.classList.add('valid');
                    return true;
                }
            }

            form.addEventListener('submit', function(e) {
                if (!validateEmail()) {
                    e.preventDefault();
                    emailInput.focus();
                } else {
                    if (submitButton) {
                        submitButton.disabled = true;
                        submitButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Enviando...';
                    }
                }
            });

            emailInput.addEventListener('input', validateEmail);
        })();
    </script>
</body>
</html>