<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Redefinir Senha - Regimath</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/css/cadastro.css"> 
    <link rel="icon" href="/imagens/Regimath_sem fundo cor preto2.png" />
</head>

<body>
    <header>
        <a href="/">
            <img src="/imagens/RM_bordo.png" alt="Regimath Logo" class="logo">
        </a>
    </header>

    <main>
        <form id="resetPasswordForm" action="/reset-password" method="POST" novalidate>
            <h2>Crie sua Nova Senha</h2>
            <input type="hidden" name="token" value="<%= token %>">

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger"><%= error %></div>
            <% } %>

            <section class="form-group">
                <label for="newPassword"><i class="fas fa-lock"></i> Nova Senha * (Mínimo 6 caracteres)</label>
                <input type="password" id="newPassword" name="newPassword" minlength="6" required>
                <p id="err-newPassword" class="error-feedback" aria-live="polite"></p>
            </section>

            <section class="form-group">
                <label for="confirmPassword"><i class="fas fa-lock"></i> Confirmar Nova Senha *</label>
                <input type="password" id="confirmPassword" name="confirmPassword" required>
                <p id="err-confirmPassword" class="error-feedback" aria-live="polite"></p>
            </section>

            <button type="submit" class="btn-primary" id="btn-submit">
                <i class="fas fa-save"></i> Salvar Nova Senha
            </button>
        </form>
    </main>
    <script>
        (function() {
            const form = document.getElementById('resetPasswordForm');
            const newPasswordInput = document.getElementById('newPassword');
            const confirmPasswordInput = document.getElementById('confirmPassword');
            const submitButton = document.getElementById('btn-submit');

            function validatePasswords() {
                const newPassword = newPasswordInput.value;
                const confirmPassword = confirmPasswordInput.value;
                let isValid = true;

                if (newPassword.length < 6) {
                    document.getElementById('err-newPassword').textContent = 'A senha deve ter pelo menos 6 caracteres.';
                    newPasswordInput.classList.add('invalid');
                    isValid = false;
                } else {
                    document.getElementById('err-newPassword').textContent = '';
                    newPasswordInput.classList.remove('invalid');
                }

                if (newPassword !== confirmPassword) {
                    document.getElementById('err-confirmPassword').textContent = 'As senhas não coincidem.';
                    confirmPasswordInput.classList.add('invalid');
                    isValid = false;
                } else {
                    document.getElementById('err-confirmPassword').textContent = '';
                    confirmPasswordInput.classList.remove('invalid');
                }

                return isValid;
            }

            form.addEventListener('submit', function(e) {
                if (!validatePasswords()) {
                    e.preventDefault();
                } else {
                    if (submitButton) {
                        submitButton.disabled = true;
                        submitButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Salvando...';
                    }
                }
            });

            newPasswordInput.addEventListener('input', validatePasswords);
            confirmPasswordInput.addEventListener('input', validatePasswords);
        })();
    </script>
</body>
</html>