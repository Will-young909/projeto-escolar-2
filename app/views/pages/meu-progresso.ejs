<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Meu Progresso</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="../css/accessibility.css">
  <link rel="icon" href="../imagens/Regimath_sem fundo cor preto2.png" />
  <style>
    :root {
      --bordo: #800020;
      --bordo-escuro: #520d23;
      --bordo-claro: #a83244;
      --dourado: #f4c542;
      --verde: #16a34a;
      --vermelho: #dc2626;
      --texto: #1f2937;
      --texto-claro: #6b7280;
      --fundo: #f6f8fb;
      --card: rgba(255, 255, 255, 0.92);
      --borda: rgba(128, 0, 32, 0.08);
      --sombra: 0 12px 30px rgba(15, 23, 42, 0.10);
      --sombra-hover: 0 18px 40px rgba(15, 23, 42, 0.14);
      --raio: 18px;
      --raio-sm: 12px;
      --transicao: 0.25s ease;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "Poppins", sans-serif;
      background: var(--fundo);
      color: var(--texto);
      line-height: 1.6;
    }
    body.no-scroll {
    overflow: hidden;
}

/* =======================
        LAYOUT
======================= */
main {
  max-width: 1200px;
  margin: 2rem auto;
  padding: 1rem;
}

header {
  background: #fff;
  box-shadow: var(--sombra);
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 20px; /* Padding ajustado */
  position: sticky;
  top: 0;
  margin-left: -20px;
  z-index: 100;
  border-bottom: 2px solid var(--bordo);
  height: 60px;
}

.logo {
  margin-top: 10px;
  margin-left: -15px;
  width: 120px;
  height: 70px;
  object-fit: contain;
}

.subheader__back { border: none; background: none; color: var(--bordo); font-weight: 600; font-size: 0.9rem; padding: 0.35rem 0.6rem; border-radius: 999px; cursor: pointer; transition: 0.25s ease; }

.subheader__back:hover { background: rgba(128, 0, 32, 0.06); }

/* Overlay */
#overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  opacity: 0;
  visibility: hidden;
  transition: 0.3s;
  z-index: 1001;
}

#overlay.active {
  opacity: 1;
  visibility: visible;
}

svg {
  object-fit: contain;
  width: 24px;
  height: 24px;
  stroke: #fff;
}

    .hero {
      background: linear-gradient(135deg, var(--bordo) 0%, var(--bordo-claro) 100%);
      color: white;
      border-radius: var(--raio);
      box-shadow: var(--sombra);
      padding: 1.5rem;
      margin-bottom: 1.5rem;
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at top right, rgba(255,255,255,0.12), transparent 35%);
      pointer-events: none;
    }

    .hero h1 {
      font-size: clamp(1.6rem, 4vw, 2.2rem);
      font-weight: 800;
      margin-bottom: 0.5rem;
    }

    .hero p {
      font-size: 0.98rem;
      max-width: 700px;
      opacity: 0.95;
      margin: 0;
    }

    .card {
      border: 1px solid var(--borda);
      border-radius: var(--raio);
      background: var(--card);
      box-shadow: var(--sombra);
      transition: transform var(--transicao), box-shadow var(--transicao);
      overflow: hidden;
      margin-bottom: 1.5rem;
    }

    .card:hover {
      transform: translateY(-4px);
      box-shadow: var(--sombra-hover);
    }

    .card-body {
      padding: 1.25rem;
    }

    .card-title {
      font-weight: 700;
      color: var(--bordo);
      margin-bottom: 1rem;
      font-size: 1.05rem;
    }

    .info-box {
      background: var(--fundo);
      border: 1px solid rgba(128, 0, 32, 0.08);
      border-radius: var(--raio-sm);
      padding: 1rem;
      margin-bottom: 1rem;
    }

    .progress-label {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.6rem;
      font-size: 0.92rem;
      color: var(--texto-claro);
    }

    .progress-label strong {
      color: var(--texto);
      font-size: 1rem;
    }

    .progress {
      height: 14px;
      border-radius: 999px;
      background: var(--card);
      overflow: hidden;
    }

    .progress-bar {
      background: linear-gradient(90deg, var(--bordo), var(--bordo-claro), var(--dourado));
      font-weight: 700;
      font-size: 0.75rem;
      color: white;
      text-align: center;
      transition: width 0.6s ease;
    }

    .xp-text {
      margin-top: 0.65rem;
      font-size: 0.9rem;
      color: var(--texto-claro);
    }

    .streak-box {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      background: var(--fundo);
      border: 1px solid rgba(244, 197, 66, 0.25);
      border-radius: var(--raio-sm);
      padding: 1rem;
    }

    .streak-emoji {
      width: 46px;
      height: 46px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: var(--texto-claro);
      font-size: 1.4rem;
      flex: 0 0 auto;
    }

    .streak-box p {
      margin: 0;
    }

    .streak-box strong {
      color: var(--bordo);
    }

    .skills-card {
      background: var(--card);
      border: 1px solid var(--borda);
      border-radius: var(--raio);
      box-shadow: var(--sombra);
    }

    .skills-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .skill-column {
      background: var(--fundo);
      border: 1px solid rgba(128, 0, 32, 0.08);
      border-radius: var(--raio-sm);
      padding: 1rem;
    }

    .skill-column h6 {
      font-size: 0.95rem;
      font-weight: 700;
      margin-bottom: 0.9rem;
      display: flex;
      align-items: center;
      gap: 0.45rem;
    }

    .skill-column.strong h6 {
      color: var(--verde);
    }

    .skill-column.weak h6 {
      color: var(--vermelho);
    }

    .skill-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.65rem;
    }

    .skill-item {
      padding: 0.8rem 0.9rem;
      border-radius: 12px;
      font-weight: 600;
      font-size: 0.92rem;
      background: var(--card);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .skill-item strong {
      font-weight: 600;
    }

    .skill-item.strong {
      color: var(--verde);
      border-left: 4px solid var(--verde);
    }

    .skill-item.weak {
      color: var(--vermelho);
      border-left: 4px solid var(--vermelho);
    }

    .empty-state {
      padding: 1rem;
      border-radius: 12px;
      background: var(--card);
      color: var(--texto-claro);
      font-size: 0.92rem;
      text-align: center;
      border: 1px dashed rgba(128, 0, 32, 0.15);
    }

    /* =======================
         RESUMO DE HABILIDADES
    ======================= */
    .skills-stats {
      display: flex;
      gap: 1rem;
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--borda);
    }

    .stat-item {
      flex: 1;
      background: var(--card);
      padding: 1rem;
      border-radius: var(--raio-sm);
      border: 1px solid var(--borda);
      text-align: center;
    }

    .stat-item .stat-value {
      display: block;
      font-size: 1.75rem;
      font-weight: 800;
      color: var(--bordo);
    }

    .stat-item .stat-label {
      display: block;
      font-size: 0.85rem;
      color: var(--texto-claro);
      margin-top: 0.25rem;
    }

    .skills-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    @media (min-width: 768px) {
      .skills-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .skill-card {
      background: var(--card);
      border: 1px solid var(--borda);
      border-radius: var(--raio-sm);
      padding: 1.25rem;
      box-shadow: var(--sombra);
      transition: var(--transicao);
    }

    .skill-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--sombra-hover);
    }

    .skill-card strong {
      border-left: 4px solid var(--verde);
    }

    .skill-card weak {
      border-left: 4px solid var(--vermelho);
    }

    .skill-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.75rem;
    }

    .skill-name {
      flex: 1;
      font-weight: 700;
      font-size: 1.05rem;
      color: var(--texto);
    }

    .skill-percentual {
      font-weight: 800;
      font-size: 1.1rem;
    }

    .skill-percentual strong {
      color: var(--bordo);
    }

    .skill-level-badge {
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.2rem 0.6rem;
      border-radius: 20px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .skill-level-avanco {
      background: #dcfce7;
      color: #166534;
    }

    .skill-level-pratica {
      background: #fef3c7;
      color: #92400e;
    }

    .skill-level-reforco {
      background: #fee2e2;
      color: #991b1b;
    }

    .skill-level-nao-iniciado {
      background: #e5e7eb;
      color: #6b7280;
    }

    .skill-progress {
      height: 8px;
      background: #e5e7eb;
      border-radius: 4px;
      overflow: hidden;
      margin-bottom: 0.5rem;
    }

    .skill-progress-bar {
      height: 100%;
      border-radius: 4px;
      transition: width 0.5s ease;
    }

    .skill-progress-bar strong {
      background: var(--bordo);
    }

    .skill-progress-bar.avanco { background: var(--verde); }
    .skill-progress-bar.pratica { background: #f59e0b; }
    .skill-progress-bar.reforco { background: var(--vermelho); }
    .skill-progress-bar.nao-iniciado { background: #9ca3af; }

    .skill-meta {
      display: flex;
      justify-content: space-between;
      font-size: 0.8rem;
      color: var(--texto-claro);
      margin-top: 0.5rem;
    }

    footer {
      color: var(--texto-claro);
      font-size: 0.9rem;
    }

    @media (min-width: 768px) {
      .menu-btn,
  #overlay,
  #close-menu {
    display: none;
  }

  #toggle-menu { display: flex; }

  main {
    margin-left: 260px;
    transition: margin-left 0.3s ease;
    position: sticky;
    left: 25%;
  }

      .hero {
        padding: 2rem;
        margin-bottom: 2rem;
      }

      .card-body {
        padding: 1.5rem;
      }

      .skills-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .streak-box {
        padding: 1.1rem 1.2rem;
      }
    }

    @media (min-width: 1024px) {
      main{
    padding: 2rem -50rem;
    width: 1000px;
    position: sticky;
    left: 18%;
  }

      .hero {
        padding: 2.3rem;
      }

      .card-body {
        padding: 1.7rem;
      }

      .skills-grid {
        gap: 1.2rem;
      }
    }
  </style>
</head>
<body>
  <li class="a11y-fab pa"><button id="a11y-open-modal" aria-label="Abrir painel de acessibilidade" style="display: none; position: absolute; visibility: hidden; z-index: -99; top: -260px;"><i class="fas fa-universal-access"></i>Acessibilidade</button></li>
  <header>
    <a href="/">
      <img src="/imagens/RM_bordo.png" alt="Regimath Logo" class="logo">
    </a>
    <button class="subheader__back" onclick="history.back()">
          <i class="fas fa-arrow-left"></i> Voltar
        </button>
  </header>

  <section id="overlay"></section>

  <main class="container">
    <section class="hero">
      <h1>Meu Progresso</h1>
      <p>Acompanhe sua evolução, seus pontos fortes e as áreas para focar seus estudos.</p>
    </section>

    <div class="row">
      <div class="col-lg-4 mb-4">
        <div class="card h-100">
          <div class="card-body">
            <h5 class="card-title">Nível e Experiência</h5>

            <div class="info-box">
              <div class="progress-label">
                <span>Nível atual</span>
                <strong><%= dashboard.aluno.nivel %></strong>
              </div>

              <div class="progress">
                <div
                  class="progress-bar"
                  role="progressbar"
                  style="width: <%= dashboard.progressoNivel.percentual %>%"
                  aria-valuenow="<%= dashboard.progressoNivel.percentual %>"
                  aria-valuemin="0"
                  aria-valuemax="100">
                  <%= dashboard.progressoNivel.percentual %>%
                </div>
              </div>

              <div class="xp-text">
                <%= dashboard.progressoNivel.xpAtual %> / <%= dashboard.progressoNivel.xpProximoNivel %> XP para o próximo nível
              </div>
            </div>

            <div class="streak-box">
              <div class="streak-emoji"><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="var(--card)"><path d="M240-400q0 52 21 98.5t60 81.5q-1-5-1-9v-9q0-32 12-60t35-51l113-111 113 111q23 23 35 51t12 60v9q0 4-1 9 39-35 60-81.5t21-98.5q0-50-18.5-94.5T648-574q-20 13-42 19.5t-45 6.5q-62 0-107.5-41T401-690q-39 33-69 68.5t-50.5 72Q261-513 250.5-475T240-400Zm240 52-57 56q-11 11-17 25t-6 29q0 32 23.5 55t56.5 23q33 0 56.5-23t23.5-55q0-16-6-29.5T537-292l-57-56Zm0-492v132q0 34 23.5 57t57.5 23q18 0 33.5-7.5T622-658l18-22q74 42 117 117t43 163q0 134-93 227T480-80q-134 0-227-93t-93-227q0-129 86.5-245T480-840Z"/></svg></div>
              <div>
                <p><strong>Streak de estudo:</strong> <%= dashboard.aluno.streak %> dias</p>
                <small class="text-muted">Continue estudando todos os dias para não perder sua sequência!</small>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-8 mb-4">
        <div class="card skills-card">
          <div class="card-body">
            <h5 class="card-title">Resumo de Habilidades</h5>

            <!-- Estatísticas globais -->
            <div class="skills-stats">
              <div class="stat-item">
                <span class="stat-value"><%= dashboard.resumoHabilidades.pontosFortes.length + dashboard.resumoHabilidades.pontosAMelhorar.length %></span>
                <span class="stat-label">Habilidades praticadas</span>
              </div>
              <div class="stat-item">
                <span class="stat-value"><%
                  const todos = [...dashboard.resumoHabilidades.pontosFortes, ...dashboard.resumoHabilidades.pontosAMelhorar];
                  if (todos.length === 0) { %>0%<% } else { %>
                    <%= Math.round(todos.reduce((acc, h) => acc + Number(h.mediaPercentual || 0), 0) / todos.length) %>
                  <% } %>
                %></span>
                <span class="stat-label">Média de aproveitamento</span>
              </div>
              <div class="stat-item">
                <span class="stat-value"><%= dashboard.resumoHabilidades.pontosFortes.length %></span>
                <span class="stat-label">Pontos fortes</span>
              </div>
            </div>

            <div class="skills-grid">
              <!-- Pontos Fortes -->
              <% if (dashboard.resumoHabilidades.pontosFortes.length > 0) { %>
                <% dashboard.resumoHabilidades.pontosFortes.forEach(h => { %>
                  <div class="skill-card strong">
                    <div class="skill-header">
                      <span class="skill-name"><%= h.habilidade_nome || 'Habilidade' %></span>
                      <span class="skill-percentual"><strong><%= Math.round(h.mediaPercentual) %>%</strong></span>
                    </div>
                    <div class="skill-progress">
                      <div class="skill-progress-bar avanco" style="width: <%= Math.round(h.mediaPercentual) %>%"></div>
                    </div>
                    <div class="skill-meta">
                      <span><%= h.n_resultados %> resultado<%= h.n_resultados > 1 ? 's' : '' %></span>
                      <span class="skill-level-badge skill-level-avanco">Avançado</span>
                    </div>
                  </div>
                <% }); %>
              <% } else { %>
                <div class="empty-state">
                  Continue praticando para descobrirmos seus pontos fortes!
                </div>
              <% } %>

              <!-- Pontos a Melhorar -->
              <% if (dashboard.resumoHabilidades.pontosAMelhorar.length > 0) { %>
                <% dashboard.resumoHabilidades.pontosAMelhorar.forEach(h => { %>
                  <div class="skill-card weak">
                    <div class="skill-header">
                      <span class="skill-name"><%= h.habilidade_nome || 'Habilidade' %></span>
                      <span class="skill-percentual"><strong><%= Math.round(h.mediaPercentual) %>%</strong></span>
                    </div>
                    <div class="skill-progress">
                      <div class="skill-progress-bar <%= h.mediaPercentual >= 40 ? 'pratica' : 'reforco' %>" style="width: <%= Math.round(h.mediaPercentual) %>%"></div>
                    </div>
                    <div class="skill-meta">
                      <span><%= h.n_resultados %> resultado<%= h.n_resultados > 1 ? 's' : '' %></span>
                      <span class="skill-level-badge skill-level-<%= h.mediaPercentual >= 40 ? 'pratica' : 'reforco' %>">
                        <%= h.mediaPercentual >= 40 ? 'Pratica' : 'Reforço' %>
                      </span>
                    </div>
                  </div>
                <% }); %>
              <% } else { %>
                <div class="empty-state">
                  Nenhum ponto de melhoria específico no momento. Ótimo trabalho!
                </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script src="../js/accessibility.js"></script>
  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
    const menuBtn = document.getElementById('menu-btn');
    const menu = document.getElementById('menu');
    const overlay = document.getElementById('overlay');
    const closeBtn = document.getElementById('close-menu');
    const toggleBtn = document.getElementById("toggle-menu");

    function toggleMobileMenu() {
      menu.classList.toggle('active');
      overlay.classList.toggle('active');
      document.body.classList.toggle('no-scroll', menu.classList.contains('active'));
    }

    if (menuBtn) menuBtn.addEventListener('click', toggleMobileMenu);
    if (overlay) overlay.addEventListener('click', toggleMobileMenu);
    if (closeBtn) closeBtn.addEventListener('click', toggleMobileMenu);

    if (toggleBtn) {
      const toggleIcon = document.getElementById('toggle-icon');
      const isCollapsed = menu.classList.contains('collapsed');
      toggleBtn.setAttribute('aria-expanded', isCollapsed ? 'false' : 'true');
      if (isCollapsed) toggleIcon.style.transform = 'rotate(180deg)';

      toggleBtn.addEventListener("click", (e) => {
        e.preventDefault();
        menu.classList.toggle("collapsed");
        const isNowCollapsed = menu.classList.contains('collapsed');
        toggleBtn.setAttribute('aria-expanded', isNowCollapsed ? 'false' : 'true');
        toggleIcon.style.transform = isNowCollapsed ? 'rotate(180deg)' : 'rotate(0deg)';
      });
    }});
  </script>
</body>
</html>