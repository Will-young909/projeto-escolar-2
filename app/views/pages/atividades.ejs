<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.activity ? 'Editar Atividade' : 'Criar Atividade' %> | RegiMath</title>

  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/atividades.css">
  <link rel="stylesheet" href="../css/accessibility.css">
  <link rel="icon" href="/imagens/Regimath_sem fundo cor preto2.png"/>
</head>
<body>
  <li class="a11y-fab pa" style="display: none; position: absolute; visibility: hidden; z-index: -99; left: -260px;"><button id="a11y-open-modal" aria-label="Abrir painel de acessibilidade" ><i class="fas fa-universal-access"></i>Acessibilidade</button></li>

  <header class="header">
    <a href="/">
      <img src="/imagens/RM_bordo.png" alt="Regimath Logo" class="logo">
    </a>
    <button class="subheader__back" onclick="history.back()">
      <i class="fas fa-arrow-left"></i> Voltar
    </button>
  </header>

<main class="atividades-container">
  <!-- Barra de ações -->
  <div class="actions-toolbar" aria-label="Ferramentas de atividade">
    <button 
      id="add-question" 
      class="btn-icon" 
      type="button" 
      aria-label="Adicionar nova questão"
      title="Adicionar Nova Questão">
      <i class="fas fa-plus-circle"></i>
    </button>

    <button 
      class="btn-icon" 
      type="button" 
      aria-label="Importar questões"
      title="Importar Questões">
      <i class="fas fa-file-import"></i>
    </button>

    <a href="/lista_atividades" class="btn-icon" aria-label="Ver atividades salvas">
        <i class="fas fa-list-alt"></i>
    </a>
  </div>

  <div class="ia-generator-container card">
    <textarea id="ia-prompt" class="correct-answer-input" placeholder="Descreva o tipo de exercício que você deseja criar (ex: um exercício de matemática sobre equações de segundo grau com 3 questões de múltipla escolha)..."></textarea><br>
    <button style="margin-top: 10px;" id="generate-with-ia" class="btn-primary">Gerar com IA</button>
     <button class="nivel" style="background: none; border: none; align-self: center; justify-self: center;"><a href="/nivel_escolar" style="text-decoration: none; margin-top: 10px; margin-bottom: 10px;" class="btn-primary">Gerar por Nível Escolar</a></button>
  </div>

  <form id="activity-form" class="form-builder-card" autocomplete="off" method="POST" action="<%= locals.activity ? '/atividades/editar/' + activity.id : '/atividades' %>">
    <header class="form-header">
      <input 
        type="text" 
        id="activity-title" 
        name="title"
        placeholder="Título da Atividade" 
        value="<%= locals.activity ? activity.title : 'Atividade sem título' %>"
        required>
      
      <textarea 
        id="activity-description" 
        name="description"
        placeholder="Descrição da atividade"><%= locals.activity ? activity.description : '' %></textarea>
    </header>

    <section id="questions-container" aria-label="Lista de questões">
      <!-- As questões serão inseridas aqui -->
    </section>

    <button id="save-activity" class="btn-primary" type="submit">
      <%= locals.activity ? 'Atualizar Atividade' : 'Salvar Atividade' %>
    </button>
  </form>
</main>

<script src="../js/accessibility.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
  const questionsContainer = document.getElementById('questions-container');
  const addQuestionBtn = document.getElementById('add-question');
  const generateWithIaBtn = document.getElementById('generate-with-ia');
  const iaPromptTextarea = document.getElementById('ia-prompt');
  const activityForm = document.getElementById('activity-form');
  let questionCounter = 0;
  const activity = <%- locals.activity ? JSON.stringify(activity) : 'null' %>;

  const createQuestionBlock = (questionData = null) => {
    questionCounter++;
    const questionId = `question-${questionCounter}`;

    const block = document.createElement('article');
    block.classList.add('question-block');
    block.id = questionId;
    block.setAttribute('aria-label', `Questão ${questionCounter}`);

    block.innerHTML = `
      <div class="question-header">
        <input 
          type="text" 
          placeholder="Pergunta" 
          name="questions[${questionCounter}][title]"
          value="${questionData && questionData.title ? questionData.title : ''}"
          required>
        
        <select 
          class="question-type-selector" 
          name="questions[${questionCounter}][type]"
          aria-label="Tipo de questão">
          <option value="multiple_choice" ${questionData && questionData.type === 'multiple_choice' ? 'selected' : ''}>Múltipla escolha</option>
          <option value="short_text" ${questionData && questionData.type === 'short_text' ? 'selected' : ''}>Resposta curta</option>
          <option value="long_text" ${questionData && questionData.type === 'long_text' ? 'selected' : ''}>Parágrafo</option>
        </select>
      </div>

      <div class="question-content"></div>

      <div class="question-footer">
        <button 
          class="btn-icon btn-delete-question" 
          type="button"
          aria-label="Excluir questão"
          title="Excluir Questão">
          <i class="fas fa-trash"></i>
        </button>
      </div>
    `;

    questionsContainer.appendChild(block);

    const typeSelector = block.querySelector('.question-type-selector');
    typeSelector.addEventListener('change', () => updateQuestionContent(typeSelector, null));

    const deleteBtn = block.querySelector('.btn-delete-question');
    deleteBtn.addEventListener('click', () => block.remove());

    updateQuestionContent(typeSelector, questionData);

    return block;
  };

  const updateQuestionContent = (selector, questionData = null) => {
    const questionBlock = selector.closest('.question-block');
    const contentDiv = questionBlock.querySelector('.question-content');
    const type = selector.value;
    const questionId = questionBlock.id.split('-')[1];

    contentDiv.innerHTML = '';

    if (type === 'multiple_choice') {
      let optionsHtml = '';
      if (questionData && questionData.options && questionData.options.length > 0) {
        let optionIndex = 1;
        for(const optionValue of questionData.options) {
          optionsHtml += `
            <div class="option-item">
              <input type="radio" name="questions[${questionId}][correct]" value="${optionIndex}" ${questionData.correct == optionIndex ? 'checked' : ''} aria-label="Alternativa correta ${optionIndex}">
              <input type="text" name="questions[${questionId}][options][${optionIndex}]" placeholder="Opção ${optionIndex}" value="${optionValue}">
              <button class="btn-icon btn-remove-option" type="button" aria-label="Remover opção">
                <i class="fas fa-times"></i>
              </button>
            </div>
          `;
          optionIndex++;
        }
      } else {
          optionsHtml = `
          <div class="option-item">
            <input type="radio" name="questions[${questionId}][correct]" value="1" aria-label="Alternativa correta 1">
            <input type="text" name="questions[${questionId}][options][1]" placeholder="Opção 1">
            <button class="btn-icon btn-remove-option" type="button" aria-label="Remover opção">
              <i class="fas fa-times"></i>
            </button>
          </div>
          `;
      }
        
      contentDiv.innerHTML = `
        <div class="options-container">
          ${optionsHtml}
        </div>
        <button class="btn-add-option" type="button">Adicionar opção</button>
      `;
    } else if (type === 'short_text' || type === 'long_text') {
      contentDiv.innerHTML = `
        <input 
          type="text" 
          name="questions[${questionId}][correctAnswer]" 
          placeholder="Gabarito ou palavras-chave para a resposta..."
          class="correct-answer-input"
          value="${questionData && questionData.correctAnswer ? questionData.correctAnswer : ''}">
      `;
    }
  };

  questionsContainer.addEventListener('click', (e) => {
    const addOptionBtn = e.target.closest('.btn-add-option');
    const removeOptionBtn = e.target.closest('.btn-remove-option');

    if (addOptionBtn) {
      e.preventDefault();
      const questionBlock = addOptionBtn.closest('.question-block');
      const optionsContainer = questionBlock.querySelector('.options-container');
      const questionId = questionBlock.id.split('-')[1];
      const optionCount = optionsContainer.querySelectorAll('.option-item').length + 1;

      const newOption = document.createElement('div');
      newOption.classList.add('option-item');
      newOption.innerHTML = `
        <input type="radio" name="questions[${questionId}][correct]" value="${optionCount}" aria-label="Alternativa correta ${optionCount}">
        <input type="text" name="questions[${questionId}][options][${optionCount}]" placeholder="Opção ${optionCount}">
        <button class="btn-icon btn-remove-option" type="button" aria-label="Remover opção">
          <i class="fas fa-times"></i>
        </button>
      `;
      optionsContainer.appendChild(newOption);
    }

    if (removeOptionBtn) {
      e.preventDefault();
      const optionItem = removeOptionBtn.closest('.option-item');
      optionItem.remove();
    }
  });

  addQuestionBtn.addEventListener('click', () => {
    const newBlock = createQuestionBlock();
    newBlock.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  activityForm.addEventListener('submit', (event) => {
    const questions = document.querySelectorAll('.question-block');
    let allValid = true;
    let missingCorrectAnswer = false;
    let missingGabarito = false;

    questions.forEach(question => {
      question.style.border = '';
      question.title = '';

      const typeSelector = question.querySelector('.question-type-selector');
      if (!typeSelector) return;

      const questionType = typeSelector.value;

      if (questionType === 'multiple_choice') {
        const questionId = question.id.split('-')[1];
        const correctRadio = question.querySelector(`input[name="questions[${questionId}][correct]"]:checked`);
        if (!correctRadio) {
          allValid = false;
          missingCorrectAnswer = true;
          question.style.border = '2px solid red';
          question.title = 'Selecione uma resposta correta para esta questão.';
        }
      } else if (questionType === 'short_text' || questionType === 'long_text') {
        const answerInput = question.querySelector('.correct-answer-input');
        if (!answerInput || !answerInput.value.trim()) {
          allValid = false;
          missingGabarito = true;
          question.style.border = '2px solid red';
          question.title = 'Forneça um gabarito para esta questão.';
        }
      }
    });

    if (!allValid) {
      event.preventDefault();
      let alertMessage = 'Por favor, corrija os seguintes erros antes de salvar:';
      if (missingCorrectAnswer) {
        alertMessage += '\n- Marque a resposta correta para todas as questões de múltipla escolha.';
      }
      if (missingGabarito) {
        alertMessage += '\n- Forneça um gabarito para as questões de resposta curta ou parágrafo.';
      }
      alert(alertMessage);
    }
  });

  // Lógica da IA
  generateWithIaBtn.addEventListener('click', async () => {
    const prompt = iaPromptTextarea.value.trim();
    if (!prompt) {
      alert('Por favor, descreva o exercício que deseja criar.');
      return;
    }

    generateWithIaBtn.disabled = true;
    generateWithIaBtn.textContent = 'Gerando...';

    try {
      const response = await fetch('/ia/generate-exercise', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ prompt }),
      });

      if (!response.ok) {
        const errorData = await response.json();
        throw new Error(errorData.error || 'A resposta do servidor não foi OK.');
      }

      const data = await response.json();

      questionsContainer.innerHTML = '';
      questionCounter = 0;

      document.getElementById('activity-title').value = data.title || 'Atividade Gerada por IA';
      document.getElementById('activity-description').value = data.description || '';

      if (data.questions && data.questions.length > 0) {
        data.questions.forEach(q => {
          const adaptedQuestion = {
            title: q.title,
            type: q.options ? 'multiple_choice' : 'short_text',
            options: q.options ? Object.values(q.options) : [],
            correct: q.correct,
            correctAnswer: q.correctAnswer || ''
          };
          createQuestionBlock(adaptedQuestion);
        });
      }
    } catch (error) {
      console.error('Erro ao gerar exercício com IA:', error);
      alert('Não foi possível gerar o exercício. Verifique o console para mais detalhes.');
    } finally {
      generateWithIaBtn.disabled = false;
      generateWithIaBtn.textContent = 'Gerar com IA';
    }
  });

  if (activity) {
      if (activity.questions && Array.isArray(activity.questions)) {
        activity.questions.forEach(question => {
            createQuestionBlock(question)
        });
      }
  } else {
    createQuestionBlock();
  }
});
</script>

</body>
</html>