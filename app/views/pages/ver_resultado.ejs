<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resultado da Atividade | RegiMath</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/css/ver_resultado.css">
    <style>
        :root {
            --bordo: #800020;
            --bordo-claro: #800000;
            --dourado: #ffd700;
            --branco: #fff;
            --verde-sucesso: #27ae60;
            --azul-info: #3498db;
            --cinza-fundo: #f8f9fa;
        }
        body.no-scroll { overflow: hidden; }

        .options .correct { background-color: #28a745; border-left-color: #28a745; }
        .options .incorrect { background-color: #dc3545; border-left-color: #dc3545; }
        .options .correct::after { content: ' ✔ Correta'; color: var(--branco); }
        .options .incorrect.selected::after { content: ' ✘ Sua escolha'; color: var(--branco); }
        .marked-label { float: right; font-size: 0.85rem; font-weight: 700; }

        /* Estilos para questões escritas */
        .text-answer-section {
            margin-top: 15px;
        }
        .text-answer-box {
            padding: 12px 15px;
            border-radius: 8px;
            margin-top: 8px;
            border: 1px solid #ddd;
            background-color: #f8f9fa;
        }
        .text-answer-box p {
            margin: 0;
            line-height: 1.6;
        }
        .text-answer-box.user-answer.correct {
            background-color: #d4edda;
            border-color: #28a745;
            color: #155724;
        }
        .text-answer-box.user-answer.incorrect {
            background-color: #f8d7da;
            border-color: #dc3545;
            color: #721c24;
        }
        .text-answer-box.correct-answer {
            background-color: #d4edda;
            border-color: #28a745;
            color: #155724;
        }

        .ai-tutor-section {
            background-color: var(--branco);
            border: 1px solid #eee;
            border-radius: 12px;
            margin-top: 40px;
            padding: 30px;
        }

        .unlock-ai-feature {
            text-align: center;
            padding: 40px 20px;
            background-color: var(--cinza-fundo);
            border-radius: 8px;
        }
        .unlock-ai-feature h3 { font-size: 1.8rem; color: var(--bordo); }
        .unlock-ai-feature p { font-size: 1.1rem; color: #555; margin: 15px 0 25px 0;}
        .btn-unlock-ai {
            background: linear-gradient(145deg, var(--bordo), var(--bordo-claro));
            color: var(--branco); padding: 15px 30px; font-size: 1.2rem; font-weight: 600;
            border: none; border-radius: 8px; cursor: pointer; transition: all 0.3s;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        .btn-unlock-ai:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(0,0,0,0.15); }
        .btn-unlock-ai .fa-bolt { margin-right: 10px; }

        .btn-ask-explanation {
            background-color: var(--bordo);
            color: var(--branco); border: none; padding: 8px 12px; border-radius: 5px;
            cursor: pointer; font-size: 0.9rem; margin-top: 15px; transition: background-color 0.2s;
        }
        .btn-ask-explanation:hover { background-color: var(--bordo-claro); }
        .btn-ask-explanation:disabled { background-color: #ccc; cursor: not-allowed; }

        .explanation-container {
            margin-top: 15px; padding: 15px; background-color: #eaf5fd;
            border-radius: 8px; border-left: 4px solid var(--azul-info); display: none;
        }

        #ai-chat-container {
            margin-top: 30px;
            border-top: 1px solid #eee; padding-top: 30px;
        }
        #chat-history {
            height: 300px; overflow-y: auto; border: 1px solid #ddd; border-radius: 8px;
            padding: 15px; margin-bottom: 15px; background-color: #fdfdfd;
        }
        .chat-message { margin-bottom: 15px; }
        .chat-message.user { text-align: right; }
        .chat-bubble { display: inline-block; padding: 10px 15px; border-radius: 18px; max-width: 80%; }
        .chat-bubble.user { background-color: var(--bordo-claro); color: var(--branco); }
        .chat-bubble.ia { background-color: #e9ecef; color: #333; }
        #chat-input-area { display: flex; gap: 10px; }
        #chat-input { flex-grow: 1; border-radius: 5px; border: 1px solid #ccc; padding: 10px; }
        #send-chat-message { border-radius: 5px; background-color: var(--bordo); color: var(--branco); }

        /* Modal Styles (reutilizados) */
        .modal-backdrop { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 200; display: flex; align-items: center; justify-content: center; opacity: 0; visibility: hidden; transition: all 0.3s; }
        .modal-backdrop.visible { opacity: 1; visibility: visible; }
        .modal { background: var(--branco); border-radius: 12px; width: 90%; max-width: 500px; transform: translateY(-20px); transition: all 0.3s; }
        .modal-backdrop.visible .modal { transform: translateY(0); }
        .modal-header { padding: 20px 25px; border-bottom: 1px solid #eee; }
        .modal-header h3 { margin: 0; color: var(--bordo); }
        .modal-body { padding: 25px; }
        .modal-footer { padding: 15px 25px; border-top: 1px solid #eee; display: flex; justify-content: flex-end; gap: 10px; }
        .btn-modal { padding: 10px 20px; border: none; border-radius: 5px; font-weight: 600; cursor: pointer; }
        .btn-confirm { background-color: var(--verde-sucesso); color: white; }
        .btn-cancel { background-color: #eee; color: #333; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Resultado da Atividade: <%= atividade.title %></h1>

        <div class="summary">
            <p><strong>Pontuação:</strong> <%= Number(tentativa.pontuacao_total).toFixed(0) %>%</p>
            <p><strong>Questões Corretas:</strong> <%= respostas.filter(r => r.acertou).length %> de <%= tentativa.total_questoes %></p>
        </div>

        <div class="questions-container">
            <% atividade.questions.forEach((question, index) => { %>
                <% const respostaDoUsuario = respostas[index] || {}; %>
                <div class="question-card">
                    <h2>Questão <%= index + 1 %>: <%= question.text || question.title %></h2>
                    <% if (question.options) { %>
                        <ul class="options">
                            <%
                            const opcoes = Array.isArray(question.options)
                                ? question.options.map((value, i) => [String.fromCharCode(65 + i), value])
                                : Object.entries(question.options).filter(([, value]) => value);
                            const marcada = String(respostaDoUsuario.resposta_marcada || '');
                            const correta = String(question.correct || respostaDoUsuario.resposta || '');
                            opcoes.forEach(([key, value]) => {
                                let className = '';
                                const isSelected = key.toLowerCase() === marcada.toLowerCase();
                                const isCorrect = key.toLowerCase() === correta.toLowerCase();
                                if (isSelected) className = respostaDoUsuario.acertou ? 'correct selected' : 'incorrect selected';
                                else if (isCorrect) className = 'correct';
                            %>
                                <li class="<%= className %>">
                                    <strong><%= key %>)</strong> <%= value %>
                                </li>
                            <% }); %>
                        </ul>

                    <% } else { 
                        // Lógica para questões escritas (short_text e long_text)
                        const isCorrect = respostaDoUsuario.acertou;
                        const userAnswer = respostaDoUsuario.resposta_marcada || 'Não respondida';
                        const correctAnswer = question.correctAnswer || respostaDoUsuario.resposta || '';
                    %>
                        <div class="text-answer-section">
                            <p><strong>Sua resposta:</strong></p>
                            <div class="text-answer-box user-answer <%= isCorrect ? 'correct' : 'incorrect' %>">
                                <p><%= userAnswer %></p>
                            </div>

                            <% if (correctAnswer) { %>
                                <p style="margin-top: 15px;"><strong>Resposta esperada:</strong></p>
                                <div class="text-answer-box correct-answer">
                                    <p><%= correctAnswer %></p>
                                </div>
                            <% } %>
                        </div>
                    <% } %>

                    <!-- FUNCIONALIDADE DE IA -->
                    <% if (user && user.tipo === 'aluno' && !respostaDoUsuario.acertou && locals.aiTutorUnlocked) { %>
                        <button type="button" class="btn-ask-explanation" data-question-index="<%= index %>">
                            <i class="fas fa-lightbulb"></i> Pedir explicação do erro
                        </button>
                        <div class="explanation-container" id="explanation-container-<%= index %>"></div>
                    <% } %>
                </div>
            <% }); %>
        </div>
        
        <!-- SEÇÃO DE TUTORIA COM IA -->
        <% if (user && user.tipo === 'aluno') { %>
            <div class="ai-tutor-section">
                <% if (locals.aiTutorUnlocked) { %>
                    <div id="ai-chat-container">
                        <h3><i class="fas fa-comments"></i> Tire suas dúvidas</h3>
                        <p>Ainda tem perguntas sobre esta atividade? Pergunte à IA!</p>
                        <div id="chat-history"></div>
                        <div id="chat-input-area">
                            <input type="text" id="chat-input" placeholder="Digite sua pergunta...">
                            <button id="send-chat-message" class="btn-primary"><i class="fas fa-paper-plane"></i></button>
                        </div>
                    </div>
                <% } else { %>
                    <div class="unlock-ai-feature">
                        <h3><i class="fas fa-bolt"></i> Desbloqueie a Tutoria Inteligente!</h3>
                        <p>Use seu Passe de Estudos para obter explicações detalhadas sobre seus erros e tirar dúvidas com a nossa IA.</p>
                        <button id="unlock-ai-button" class="btn-unlock-ai">
                            <i class="fas fa-key"></i> Liberar Tutoria com IA
                        </button>
                    </div>
                <% } %>
            </div>
        <% } %>

        <!-- RECOMENDAÇÕES DE PROFESSORES -->
        <% const recs = recomendacoesProfessores || { focos: [], recomendacoes: [] }; %>
        <% if (recs.recomendacoes && recs.recomendacoes.length > 0) { %>
        <section class="teacher-recommendations">
            <div class="recommendation-header">
                <span class="badge">Recomendação inteligente</span>
                <h2>Professores indicados para o seu próximo passo</h2>
                <p>Usamos os pontos de atenção do seu resultado para priorizar professores com maior aderência ao reforço que você precisa.</p>
            </div>
            <div class="recommendation-grid">
                <% recs.recomendacoes.forEach(professor => { %>
                    <article class="teacher-card">
                        <img src="<%= professor.foto_perfil || '/imagens/imagem_perfil.jpg' %>" alt="Foto de <%= professor.nome %>">
                            <div>
                                <h3><%= professor.nome %></h3>
                                <p class="match-score"><%= professor.score %>% de aderência estimada</p>
                                <p class="teacher-disciplines"><%= professor.disciplinas && professor.disciplinas.length ? professor.disciplinas.join(', ') : 'Matemática' %></p>
                                <ul>
                                    <% professor.motivos.slice(0, 2).forEach(motivo => { %>
                                        <li><%= motivo %></li>
                                    <% }); %>
                                </ul>
                                <a href="/exibir_prof/<%= professor.id %>" class="recommendation-button">Ver professor</a>
                            </div>
                    </article>
                <% }); %>
            </div>
        </section>
        <% } %>

        <a href="/historico_formularios" class="back-button">Voltar ao Histórico</a>
    </div>

    <!-- MODAIS -->
    <% if (user && user.tipo === 'aluno') { %>
        <div id="activatePassModal" class="modal-backdrop">
            <div class="modal">
                <div class="modal-header"><h3><i class="fas fa-star"></i> Ativar Passe de Estudos</h3></div>
                <div class="modal-body">
                    <p>Você tem um passe disponível! Deseja ativá-lo para desbloquear a Tutoria Inteligente nesta atividade?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modal btn-cancel">Agora não</button>
                    <button type="button" id="confirmActivatePass" class="btn-modal btn-confirm">Sim, ativar!</button>
                </div>
            </div>
        </div>
        <div id="purchasePassModal" class="modal-backdrop">
             <div class="modal">
                <div class="modal-header"><h3><i class="fas fa-shopping-cart"></i> Adquira um Passe</h3></div>
                <div class="modal-body">
                    <p>Para acessar a Tutoria Inteligente, você precisa de um Passe de Estudos. Adquira um para continuar!</p>
                    <a href="/comprar-passe/semanal" class="btn-primary">Ver Passes de Estudo</a>
                </div>
                <div class="modal-footer">
                     <button type="button" class="btn-modal btn-cancel">Continuar sem IA</button>
                </div>
            </div>
        </div>
    <% } %>

    <script>
    if (<%- JSON.stringify(user || null) %> && <%- JSON.stringify(user.tipo) %> === 'aluno') {
        const pageData = {
            tentativaId: '<%= tentativa.id %>',
            aiTutorUnlocked: <%- JSON.stringify(locals.aiTutorUnlocked || false) %>,
            hasAvailablePass: <%- JSON.stringify(locals.passeDisponivel || { passeAtivo: false }) %>
        };

        function openModal(modalId) {
            document.getElementById(modalId)?.classList.add('visible');
            document.body.classList.add('no-scroll');
        }

        function closeModal(modalId) {
            document.getElementById(modalId)?.classList.remove('visible');
            document.body.classList.remove('no-scroll');
        }

        document.getElementById('unlock-ai-button')?.addEventListener('click', () => {
            if (pageData.hasAvailablePass.passeAtivo) {
                openModal('activatePassModal');
            } else {
                openModal('purchasePassModal');
            }
        });

        document.getElementById('confirmActivatePass')?.addEventListener('click', async () => {
            const button = document.getElementById('confirmActivatePass');
            button.disabled = true;
            button.textContent = 'Ativando...';

            try {
                const response = await fetch('/api/passe/ativar-para-resultado', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ tentativaId: pageData.tentativaId })
                });

                if (!response.ok) throw new Error('Falha ao ativar o passe.');
                window.location.reload();

            } catch (error) {
                console.error("Erro ao ativar passe:", error);
                alert('Ocorreu um erro ao ativar seu passe. Por favor, tente novamente.');
                button.disabled = false;
                button.textContent = 'Sim, ativar!';
            }
        });

        document.querySelectorAll('.btn-ask-explanation').forEach(button => {
            button.addEventListener('click', async (event) => {
                const clickedButton = event.currentTarget;
                const questionIndex = clickedButton.dataset.questionIndex;
                const explanationContainer = document.getElementById(`explanation-container-${questionIndex}`);
                
                if (!explanationContainer) return;

                clickedButton.disabled = true;
                clickedButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Gerando...';

                try {
                    const response = await fetch(`/api/resultado/${pageData.tentativaId}/explicacao/${questionIndex}`);
                    if (!response.ok) {
                        const errorData = await response.json();
                        throw new Error(errorData.message || 'Erro no servidor');
                    }
                    const data = await response.json();

                    explanationContainer.innerHTML = `<p>${data.explicacao}</p>`;
                    explanationContainer.style.display = 'block';
                    clickedButton.style.display = 'none';

                } catch (error) {
                    explanationContainer.innerHTML = `<p><strong>Erro:</strong> ${error.message}</p>`;
                    explanationContainer.style.display = 'block';
                    clickedButton.disabled = false;
                    clickedButton.innerHTML = '<i class="fas fa-lightbulb"></i> Tentar Novamente';
                }
            });
        });
        
        const chatHistory = document.getElementById('chat-history');
        const chatInput = document.getElementById('chat-input');
        const sendButton = document.getElementById('send-chat-message');

        if (chatHistory) {
            const addMessageToHistory = (message, sender) => {
                const msgDiv = document.createElement('div');
                msgDiv.classList.add('chat-message', sender);
                const bubbleDiv = document.createElement('div');
                bubbleDiv.classList.add('chat-bubble', sender);
                bubbleDiv.textContent = message;
                msgDiv.appendChild(bubbleDiv);
                chatHistory.appendChild(msgDiv);
                chatHistory.scrollTop = chatHistory.scrollHeight;
            }

            const handleSendMessage = async () => {
                const userMessage = chatInput.value.trim();
                if (!userMessage) return;

                addMessageToHistory(userMessage, 'user');
                chatInput.value = '';
                sendButton.disabled = true;

                const messages = Array.from(chatHistory.querySelectorAll('.chat-message')).map(msg => ({
                    role: msg.classList.contains('user') ? 'user' : 'assistant',
                    content: msg.querySelector('.chat-bubble').textContent
                }));

                try {
                    const response = await fetch(`/api/resultado/${pageData.tentativaId}/chat`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ messages: messages })
                    });

                    if (!response.ok) {
                         const errorData = await response.json();
                        throw new Error(errorData.message || 'Erro ao comunicar com a IA');
                    }

                    const data = await response.json();
                    addMessageToHistory(data.reply, 'ia');

                } catch (error) {
                    addMessageToHistory(`Erro: ${error.message}`, 'ia');
                } finally {
                    sendButton.disabled = false;
                }
            }
            sendButton.addEventListener('click', handleSendMessage);
            chatInput.addEventListener('keypress', (e) => { if (e.key === 'Enter') handleSendMessage(); });
        }

        document.querySelectorAll('.modal-backdrop').forEach(backdrop => {
            backdrop.addEventListener('click', function(e) { if(e.target === this) closeModal(this.id); });
        });
        document.querySelectorAll('.btn-cancel').forEach(btn => {
            const modal = btn.closest('.modal-backdrop');
            if (modal) btn.addEventListener('click', () => closeModal(modal.id));
        });
    }
    </script>
</body>
</html>
