<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/responsive.css">
    <title>Resultado da Atividade | RegiMath</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/css/ver_resultado.css">
    <link rel="stylesheet" href="../css/accessibility.css">
    <link rel="icon" href="../imagens/Regimath_sem fundo cor preto2.png" />
    <style>
        :root {
            --bordo: #800020;
            --bordo-claro: #800000;
            --dourado: #ffd700;
            --branco: #fff;
            --verde-sucesso: #27ae60;
            --azul-info: #3498db;
            --cinza-fundo: #f8f9fa;
        }
        body.no-scroll { overflow: hidden; }

        .options .correct { background-color: #28a745; border-left-color: #28a745; }
        .options .incorrect { background-color: #dc3545; border-left-color: #dc3545; }
        .options .correct::after { content: ' ✔ Correta'; color: var(--branco); }
        .options .incorrect.selected::after { content: ' ✘ Sua escolha'; color: var(--branco); }
        .marked-label { float: right; font-size: 0.85rem; font-weight: 700; }

        /* Estilos para questões escritas */
        .text-answer-section {
            margin-top: 15px;
        }
        .text-answer-box {
            padding: 12px 15px;
            border-radius: 8px;
            margin-top: 8px;
            border: 1px solid #ddd;
            background-color: #f8f9fa;
        }
        .text-answer-box p {
            margin: 0;
            line-height: 1.6;
        }
        .text-answer-box.user-answer.correct {
            background-color: #28a745;
            border-color: #28a745;
            color: #fff;
        }
        .text-answer-box.user-answer.incorrect {
            background-color: #dc3545;
            border-color: #dc3545;
            color: #fff;
        }
        .text-answer-box.correct-answer {
            background-color: #28a745;
            border-color: #28a745;
            color: #fff;
        }

        .ai-tutor-section {
            background-color: var(--branco);
            border: 1px solid #eee;
            border-radius: 12px;
            margin-top: 40px;
            padding: 30px;
        }

        .unlock-ai-feature {
            text-align: center;
            padding: 40px 20px;
            background-color: var(--cinza-fundo);
            border-radius: 8px;
        }
        .unlock-ai-feature h3 { font-size: 1.8rem; color: var(--bordo); }
        .unlock-ai-feature p { font-size: 1.1rem; color: #555; margin: 15px 0 25px 0;}
        .btn-unlock-ai {
            background: linear-gradient(145deg, var(--bordo), var(--bordo-claro));
            color: var(--branco); padding: 15px 30px; font-size: 1.2rem; font-weight: 600;
            border: none; border-radius: 8px; cursor: pointer; transition: all 0.3s;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        .btn-unlock-ai:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(0,0,0,0.15); }
        .btn-unlock-ai .fa-bolt { margin-right: 10px; }

        .btn-ask-explanation {
            background-color: var(--bordo);
            color: var(--branco); border: none; padding: 8px 12px; border-radius: 5px;
            cursor: pointer; font-size: 0.9rem; margin-top: 15px; transition: background-color 0.2s;
        }
        .btn-ask-explanation:hover { background-color: var(--bordo-claro); }
        .btn-ask-explanation:disabled { background-color: #ccc; cursor: not-allowed; }

        .explanation-container {
            margin-top: 15px; padding: 15px; background-color: #eaf5fd;
            border-radius: 8px; border-left: 4px solid var(--azul-info); display: none;
        }

        #ai-chat-container {
            margin-top: 30px;
            border-top: 1px solid #eee; padding-top: 30px;
        }
        #chat-history {
            height: 300px; overflow-y: auto; border: 1px solid #ddd; border-radius: 8px;
            padding: 15px; margin-bottom: 15px; background-color: #fdfdfd;
        }
        .chat-message { margin-bottom: 15px; }
        .chat-message.user { text-align: right; }
        .chat-bubble { display: inline-block; padding: 10px 15px; border-radius: 18px; max-width: 80%; }
        .chat-bubble.user { background-color: var(--bordo-claro); color: var(--branco); }
        .chat-bubble.ia { background-color: #e9ecef; color: #333; }
        #chat-input-area { display: flex; gap: 10px; }
        #chat-input { flex-grow: 1; border-radius: 5px; border: 1px solid #ccc; padding: 10px; }
        #send-chat-message { border-radius: 5px; background-color: var(--bordo); color: var(--branco); }

        /* Modal Styles (reutilizados) */
        .modal-backdrop { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 200; display: flex; align-items: center; justify-content: center; opacity: 0; visibility: hidden; transition: all 0.3s; overflow-x: hidden; overflow-y: auto; -webkit-overflow-scrolling: touch; overscroll-behavior: contain; padding: 16px 0; }
        .modal-backdrop { align-items: center; align-items: safe center; }
        .modal-backdrop.visible { opacity: 1; visibility: visible; }
        .modal { background: var(--branco); border-radius: 12px; width: 90%; max-width: 500px; max-height: 90vh; overflow-y: auto; transform: translateY(-20px); transition: all 0.3s; }
        .modal-backdrop.visible .modal { transform: translateY(0); }
        .modal-header { padding: 15px 25px; border-bottom: 1px solid #eee; display: flex; justify-content: space-between; align-items: center; }
        .modal-header h3 { margin: 0; color: var(--bordo); }
        .close-button { background: none; border: none; font-size: 2rem; cursor: pointer; color: #888; }
        .modal-body { padding: 25px; }
        .modal-footer { padding: 15px 25px; border-top: 1px solid #eee; display: flex; justify-content: flex-end; gap: 10px; }
        .btn-modal { padding: 10px 20px; border: none; border-radius: 5px; font-weight: 600; cursor: pointer; }
        .btn-confirm { background-color: var(--verde-sucesso); color: white; }
        .btn-cancel { background-color: #eee; color: #333; }

        /* Modal de Compra de Passe (mesmo conteúdo do modal de explorar_atividades) */
        .modal-header { padding: 15px 25px; border-bottom: 1px solid #eee; display: flex; justify-content: space-between; align-items: center; }
        .modal-header h3 { margin-bottom: 0; color: var(--bordo); font-size: 1.5rem; }
        .modal-intro-text { margin-bottom: 20px; text-align: center; font-size: 1.1rem; color: var(--cinza-texto); }
        .pass-options { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; }
        .pass-card { border: 1px solid #ddd; border-radius: 8px; padding: 20px; text-align: center; transition: all 0.2s ease; }
        .pass-card:hover, .pass-card.featured { border-color: var(--bordo); transform: translateY(-5px); box-shadow: 0 4px 10px rgba(128, 0, 32, 0.1); }
        .pass-card h4 { font-size: 1.4rem; color: var(--bordo-claro); margin-bottom: 10px; }
        .pass-card .price { font-size: 1.8rem; font-weight: 600; color: #333; margin-bottom: 15px; }
        .pass-card p { font-size: 0.9rem; color: var(--cinza-texto); min-height: 54px; }
        .btn-purchase { display: block; background: var(--verde-sucesso); color: white; padding: 12px; border-radius: 5px; text-decoration: none; font-weight: 600; transition: background 0.2s; }
        .btn-purchase:hover { background: #2ecc71; }

        /* Ajustes dos modais para telas pequenas (mobile) */
        @media (max-width: 600px) {
            .modal-backdrop { padding: 10px 0; }
            .modal { width: 95%; border-radius: 10px; }
            .modal-header, .modal-body { padding-left: 16px; padding-right: 16px; }
            .modal-header h3 { font-size: 1.2rem; }
            .pass-options { grid-template-columns: 1fr; gap: 24px; }
            .pass-card { padding: 16px; }
            .pass-card p { min-height: 0; }
            .pass-card .price { font-size: 1.6rem; }
        }
    </style>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  </head>
<body>
    <button id="a11y-open-modal" aria-label="Abrir painel de acessibilidade" style="display: none; position: absolute; visibility: hidden; z-index: -99; top: -260px;"><i class="fas fa-universal-access"></i>Acessibilidade</button>
    <header>
       <a href="/">
          <img src="/imagens/RM_bordo.png" alt="Regimath Logo" class="logo">
        </a>
    </header>
    <section class="container">
        <h1>Resultado da Atividade: <%= atividade.title %></h1>

        <div class="summary">
            <p><strong>Pontuação:</strong> <%= Number(tentativa.pontuacao_total).toFixed(0) %>%</p>
            <p><strong>Questões Corretas:</strong> <%= respostas.filter(r => r.acertou).length %> de <%= tentativa.total_questoes %></p>
        </div>

        <section class="questions-container">
            <% atividade.questions.forEach((question, index) => { %>
                <% const respostaDoUsuario = respostas[index] || {}; %>
                <section class="question-card">
                    <h2>Questão <%= index + 1 %>: <%= question.text || question.title %></h2>
                    <% if (question.options) { %>
                        <ul class="options">
                            <%
                            const opcoes = Array.isArray(question.options)
                                ? question.options.map((value, i) => [String.fromCharCode(65 + i), value])
                                : Object.entries(question.options).filter(([, value]) => value);
                            const marcada = String(respostaDoUsuario.resposta_marcada || '');
                            const correta = String(question.correct || respostaDoUsuario.resposta || '');
                            opcoes.forEach(([key, value]) => {
                                let className = '';
                                const isSelected = key.toLowerCase() === marcada.toLowerCase();
                                const isCorrect = key.toLowerCase() === correta.toLowerCase();
                                if (isSelected) className = respostaDoUsuario.acertou ? 'correct selected' : 'incorrect selected';
                                else if (isCorrect) className = 'correct';
                            %>
                                <li class="<%= className %>">
                                    <strong><%= key %>)</strong> <%= value %>
                                </li>
                            <% }); %>
                        </ul>

                    <% } else { 
                        const _normKw = (text) => String(text || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9\s]/g, ' ').replace(/\s+/g, ' ').trim();
                        const _parseKws = (raw) => {
                            const str = String(raw || '').trim();
                            if (!str) return [];
                            if (/(\([^)]*(obrigatoria|obrigat[oó]ria|opcional|required|optional|peso\s*=)\s*[^)]*\))/i.test(str) || str.includes(';')) {
                                return str.split(/[;,]+/).map(p => p.trim()).filter(Boolean).map(p => {
                                    const m = p.match(/^(.*?)(?:\(([^)]*)\))?\s*$/);
                                    const text = (m ? m[1] : p).trim();
                                    const meta = (m && m[2] ? m[2] : '').toLowerCase();
                                    const required = /obrigat|required/.test(meta);
                                    const pesoMatch = meta.match(/peso\s*=\s*(\d+(?:[\.,]\d+)?)/i);
                                    const peso = pesoMatch ? Math.max(0.1, Number(pesoMatch[1].replace(',', '.')) || 1) : 1;
                                    return text ? { text, required, peso } : null;
                                }).filter(Boolean);
                            }
                            return str.split(/[,\n]+/).map(p => p.trim()).filter(Boolean).map(p => {
                                const required = /\*$/.test(p) || /^\*/.test(p);
                                const text = p.replace(/^\*+|\*+$/g, '').trim();
                                return text ? { text, required, peso: 1 } : null;
                            }).filter(Boolean);
                        };
                        const userAnswer = respostaDoUsuario.resposta_marcada || 'Não respondida';
                        const correctAnswer = question.correctAnswer || respostaDoUsuario.resposta || '';
                        const keywords = Array.isArray(question.keywords) && question.keywords.length ? question.keywords : _parseKws(correctAnswer);
                        const normUser = _normKw(userAnswer);
                        const kwDetails = keywords.map(k => ({ ...k, found: normUser.includes(_normKw(k.text)) }));
                        const totalW = kwDetails.reduce((sum, k) => sum + (Number(k.peso) || 1), 0);
                        const matchedW = kwDetails.reduce((sum, k) => sum + (k.found ? (Number(k.peso) || 1) : 0), 0);
                        const missingRequired = kwDetails.some(k => k.required && !k.found);
                        const kwScore = kwDetails.length ? (missingRequired ? 0 : (totalW > 0 ? (matchedW / totalW) * 100 : 0)) : (respostaDoUsuario.acertou ? 100 : 0);
                        const isCorrect = kwScore >= 99.999;
                    %>
                        <div class="text-answer-section">
                            <p><strong style="color: var(--color-text-dark);">Sua resposta:</strong></p>
                            <div class="text-answer-box user-answer <%= isCorrect ? 'correct' : 'incorrect' %>">
                                <p><%= isCorrect ? '✔' : '✘' %> <%= userAnswer %></p>
                            </div>

                            <% if (kwDetails.length > 0) { %>
                                <div class="keyword-feedback" style="margin-top:12px; padding:12px; border:1px solid #e5e7eb; border-radius:8px; background:#fff;">
                                    <p style="margin:0 0 8px;"><strong>Palavras-chave:</strong></p>
                                    <ul style="list-style:none; padding:0; margin:0; display:grid; gap:6px;">
                                        <% kwDetails.forEach(k => { %>
                                            <li style="color:<%= k.found ? '#166534' : '#991b1b' %>;">
                                                <%= k.found ? '✅' : '❌' %> <%= k.text %><% if (k.required) { %> <small>(obrigatória)</small><% } %><% if (Number(k.peso) && Number(k.peso) !== 1) { %> <small>(peso <%= k.peso %>)</small><% } %>
                                            </li>
                                        <% }) %>
                                    </ul>
                                    <div class="keyword-score" style="margin-top:10px; font-weight:600;">
                                        Nota: <%= kwScore.toFixed(1).replace('.', ',') %>% (<%= kwDetails.filter(k => k.found).length %>/<%= kwDetails.length %> palavras-chave)
                                    </div>
                                </div>
                            <% } %>

                            <% if (correctAnswer) { %>
                                <p style="margin-top: 15px;"><strong style="color: var(--color-text-dark);">Resposta esperada:</strong></p>
                                <div class="text-answer-box correct-answer">
                                    <p>✔ <%= correctAnswer %></p>
                                </div>
                            <% } %>
                        </div>
                    <% } %>

                    <!-- FUNCIONALIDADE DE IA -->
                    <% if (user && user.tipo === 'aluno' && !respostaDoUsuario.acertou && locals.aiTutorUnlocked) { %>
                        <button type="button" class="btn-ask-explanation" data-question-index="<%= index %>">
                            <i class="fas fa-lightbulb"></i> Pedir explicação do erro
                        </button>
                        <div class="explanation-container" id="explanation-container-<%= index %>"></div>
                    <% } %>
                </section>
            <% }); %>
        </section>
        
        <!-- SEÇÃO DE TUTORIA COM IA -->
        <% if (user && user.tipo === 'aluno') { %>
            <section class="ai-tutor-section">
                <% if (locals.aiTutorUnlocked) { %>
                    <section id="ai-chat-container">
                        <h3><i class="fas fa-comments"></i> Tire suas dúvidas</h3>
                        <p>Ainda tem perguntas sobre esta atividade? Pergunte à IA!</p>
                        <div id="chat-history"></div>
                        <div id="chat-input-area">
                            <input type="text" id="chat-input" placeholder="Digite sua pergunta...">
                            <button id="send-chat-message" class="btn-primary"><i class="fas fa-paper-plane"></i></button>
                        </div>
                    </section>
                <% } else { %>
                    <section class="unlock-ai-feature">
                        <h3><i class="fas fa-bolt"></i> Desbloqueie a Tutoria Inteligente!</h3>
                        <p>Use seu Passe de Estudos para obter explicações detalhadas sobre seus erros e tirar dúvidas com a nossa IA.</p>
                        <button id="unlock-ai-button" class="btn-unlock-ai">
                            <i class="fas fa-key"></i> Liberar Tutoria com IA
                        </button>
                    </section>
                <% } %>
            </section>
        <% } %>

        <!-- RECOMENDAÇÕES DE PROFESSORES -->
        <% const recs = recomendacoesProfessores || { focos: [], recomendacoes: [] }; %>
        <% if (recs.recomendacoes && recs.recomendacoes.length > 0) { %>
        <section class="teacher-recommendations">
            <section class="recommendation-header">
                <span class="badge">Recomendação inteligente</span>
                <h2>Professores indicados para o seu próximo passo</h2>
                <p>Usamos os pontos de atenção do seu resultado para priorizar professores com maior aderência ao reforço que você precisa.</p>
            </section>
            <section class="recommendation-grid">
                <% recs.recomendacoes.forEach(professor => { %>
                    <article class="teacher-card">
                        <img src="<%= professor.foto_perfil || '/imagens/imagem_perfil.jpg' %>" alt="Foto de <%= professor.nome %>">
                            <section>
                                <h3><%= professor.nome %></h3>
                                <p class="match-score"><%= professor.score %>% de aderência estimada</p>                               
                                <ul>
                                    <% professor.motivos.slice(0, 2).forEach(motivo => { %>
                                        <li><%= motivo %></li>
                                    <% }); %>
                                </ul>
                                <a href="/exibir_prof/<%= professor.id %>" class="recommendation-button btn-ver-perfil" data-professor-id="<%= professor.id %>" data-tentativa-id="<%= tentativa.id || '' %>" data-posicao="<%= recs.recomendacoes.indexOf(professor) + 1 %>" data-score="<%= professor.score %>">Ver professor</a>
                            </section>
                    </article>
                <% }); %>
            </section>
        </section>
        <% } %>

        <a href="/historico_formularios" class="back-button">Voltar ao Histórico</a>
        <a href="/explorar_atividades" class="back-button">Voltar para as atividades</a>
    </section>

    <!-- MODAIS -->
    <% if (user && user.tipo === 'aluno') { %>
        <section id="activatePassModal" class="modal-backdrop">
            <section class="modal">
                <section class="modal-header"><h3><i class="fas fa-star"></i> Ativar Passe de Estudos</h3></section>
                <div class="modal-body">
                    <p>Você tem um passe disponível! Deseja ativá-lo para desbloquear a Tutoria Inteligente nesta atividade?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modal btn-cancel">Agora não</button>
                    <button type="button" id="confirmActivatePass" class="btn-modal btn-confirm">Sim, ativar!</button>
                </div>
            </section>
        </section>
        <section id="purchasePassModal" class="modal-backdrop">
             <section class="modal">
                <section class="modal-header"><h3><i class="fas fa-shopping-cart"></i> Adquira um Passe</h3></section>
                <div class="modal-body">
                    <p>Para acessar a Tutoria Inteligente, você precisa de um Passe de Estudos. Adquira um para continuar!</p>
                    <a href="/comprar-passe/semanal" id="view-pass-options-link" class="btn-primary">Ver Passes de Estudo</a>
                </div>
                <div class="modal-footer">
                     <button type="button" class="btn-modal btn-cancel">Continuar sem IA</button>
                </div>
            </section>
        </section>
        <section id="passOptionsModal" class="modal-backdrop">
            <section class="modal" style="max-width: 800px;">
                <section class="modal-header">
                    <h3><i class="fas fa-ticket-alt"></i> Passe de Estudos</h3>
                    <button type="button" class="close-button">&times;</button>
                </section>
                <section class="modal-body">
                    <p class="modal-intro-text">Escolha o Passe de Estudos ideal para você e continue aprendendo!</p>
                    <section class="pass-options">
                        <section class="pass-card">
                            <h4>Passe +10</h4>
                            <p>+10 atividades para usar quando quiser.</p>
                            <p class="price">R$ 10,00</p>
                            <a href="/comprar-passe/quantidade_10" class="btn-purchase">Comprar Agora</a>
                        </section>
                        <section class="pass-card">
                            <h4>Passe Diário</h4>
                            <p>Atividades ilimitadas pelas próximas 24 horas.</p>
                            <p class="price">R$ 15,00</p>
                            <a href="/comprar-passe/diario" class="btn-purchase">Comprar Agora</a>
                        </section>
                        <section class="pass-card">
                            <h4>Passe Semanal</h4>
                            <p>Atividades ilimitadas por 7 dias.</p>
                            <p class="price">R$ 25,00</p>
                            <a href="/comprar-passe/semanal" class="btn-purchase">Comprar Agora</a>
                        </section>
                    </section>
                </section>
            </section>
        </section>
    <% } %>

    <script src="../js/accessibility.js"></script>
    <script>
    if (<%- JSON.stringify(user || null) %> && <%- JSON.stringify(user.tipo) %> === 'aluno') {
        const pageData = {
            tentativaId: '<%= tentativa.id %>',
            aiTutorUnlocked: <%- JSON.stringify(locals.aiTutorUnlocked || false) %>,
            hasAvailablePass: <%- JSON.stringify(locals.passeDisponivel || { passeAtivo: false }) %>
        };

        function openModal(modalId) {
            document.getElementById(modalId)?.classList.add('visible');
            document.body.classList.add('no-scroll');
        }

        function closeModal(modalId) {
            document.getElementById(modalId)?.classList.remove('visible');
            // Só libera o scroll do body se nenhum outro modal ainda estiver aberto.
            if (document.querySelectorAll('.modal-backdrop.visible').length === 0) {
                document.body.classList.remove('no-scroll');
            }
        }

        // O link "Ver Passes de Estudo" abre o modal com as opções de passe
        // (igual ao de explorar_atividades) em vez de navegar para o link.
        document.getElementById('view-pass-options-link')?.addEventListener('click', (e) => {
            e.preventDefault();
            openModal('passOptionsModal');
        });

        document.getElementById('unlock-ai-button')?.addEventListener('click', () => {
            if (pageData.hasAvailablePass.passeAtivo) {
                openModal('activatePassModal');
            } else {
                openModal('purchasePassModal');
            }
        });

        document.getElementById('confirmActivatePass')?.addEventListener('click', async () => {
            const button = document.getElementById('confirmActivatePass');
            button.disabled = true;
            button.textContent = 'Ativando...';

            try {
                const response = await fetch('/api/passe/ativar-para-resultado', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ tentativaId: pageData.tentativaId })
                });

                if (!response.ok) throw new Error('Falha ao ativar o passe.');
                window.location.reload();

            } catch (error) {
                console.error("Erro ao ativar passe:", error);
                Swal.fire("Ocorreu um erro ao ativar seu passe. Por favor, tente novamente.");
                button.disabled = false;
                button.textContent = 'Sim, ativar!';
            }
        });

        document.querySelectorAll('.btn-ask-explanation').forEach(button => {
            button.addEventListener('click', async (event) => {
                const clickedButton = event.currentTarget;
                const questionIndex = clickedButton.dataset.questionIndex;
                const explanationContainer = document.getElementById(`explanation-container-${questionIndex}`);
                
                if (!explanationContainer) return;

                clickedButton.disabled = true;
                clickedButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Gerando...';

                try {
                    const response = await fetch(`/api/resultado/${pageData.tentativaId}/explicacao/${questionIndex}`);
                    if (!response.ok) {
                        const errorData = await response.json();
                        throw new Error(errorData.message || 'Erro no servidor');
                    }
                    const data = await response.json();

                    explanationContainer.innerHTML = `<p>${data.explicacao}</p>`;
                    explanationContainer.style.display = 'block';
                    clickedButton.style.display = 'none';

                } catch (error) {
                    explanationContainer.innerHTML = `<p><strong>Erro:</strong> ${error.message}</p>`;
                    explanationContainer.style.display = 'block';
                    clickedButton.disabled = false;
                    clickedButton.innerHTML = '<i class="fas fa-lightbulb"></i> Tentar Novamente';
                }
            });
        });
        
        const chatHistory = document.getElementById('chat-history');
        const chatInput = document.getElementById('chat-input');
        const sendButton = document.getElementById('send-chat-message');

        if (chatHistory) {
            const addMessageToHistory = (message, sender) => {
                const msgDiv = document.createElement('section');
                msgDiv.classList.add('chat-message', sender);
                const bubbleDiv = document.createElement('section');
                bubbleDiv.classList.add('chat-bubble', sender);
                bubbleDiv.textContent = message;
                msgDiv.appendChild(bubbleDiv);
                chatHistory.appendChild(msgDiv);
                chatHistory.scrollTop = chatHistory.scrollHeight;
            }

            const handleSendMessage = async () => {
                const userMessage = chatInput.value.trim();
                if (!userMessage) return;

                addMessageToHistory(userMessage, 'user');
                chatInput.value = '';
                sendButton.disabled = true;

                const messages = Array.from(chatHistory.querySelectorAll('.chat-message')).map(msg => ({
                    role: msg.classList.contains('user') ? 'user' : 'assistant',
                    content: msg.querySelector('.chat-bubble').textContent
                }));

                try {
                    const response = await fetch(`/api/resultado/${pageData.tentativaId}/chat`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ messages: messages })
                    });

                    if (!response.ok) {
                         const errorData = await response.json();
                        throw new Error(errorData.message || 'Erro ao comunicar com a IA');
                    }

                    const data = await response.json();
                    addMessageToHistory(data.reply, 'ia');

                } catch (error) {
                    addMessageToHistory(`Erro: ${error.message}`, 'ia');
                } finally {
                    sendButton.disabled = false;
                }
            }
            sendButton.addEventListener('click', handleSendMessage);
            chatInput.addEventListener('keypress', (e) => { if (e.key === 'Enter') handleSendMessage(); });
        }

        document.querySelectorAll('.modal-backdrop').forEach(backdrop => {
            backdrop.addEventListener('click', function(e) { if(e.target === this) closeModal(this.id); });
        });
        document.querySelectorAll('.btn-cancel').forEach(btn => {
            const modal = btn.closest('.modal-backdrop');
            if (modal) btn.addEventListener('click', () => closeModal(modal.id));
        });
        document.querySelectorAll('.close-button').forEach(btn => {
            const modal = btn.closest('.modal-backdrop');
            if (modal) btn.addEventListener('click', () => closeModal(modal.id));
        });
    }
    </script>
    <script>
          document.addEventListener('DOMContentLoaded', function() {
            var returnTo = window.location.href;
            document.querySelectorAll('a[href^="/exibir_prof/"]').forEach(function(a) {
              var href = a.getAttribute('href');
              if (href && href.indexOf('returnTo=') === -1) {
                var sep = href.indexOf('?') >= 0 ? '&' : '?';
                a.setAttribute('href', href + sep + 'returnTo=' + encodeURIComponent(returnTo));
              }
            });
            document.querySelectorAll('.btn-ver-perfil').forEach(function(btn) {
              btn.addEventListener('click', function() {
                var payload = JSON.stringify({
                  professorId: btn.dataset.professorId,
                  tentativaId: btn.dataset.tentativaId || null,
                  posicao: btn.dataset.posicao || null,
                  score: btn.dataset.score || null
                });
                try {
                  if (navigator.sendBeacon) {
                    navigator.sendBeacon('/api/recomendacao/registrar-clique', new Blob([payload], { type: 'application/json' }));
                  } else {
                    fetch('/api/recomendacao/registrar-clique', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: payload, keepalive: true });
                  }
                } catch (e) {}
              });
            });
          });
        </script>
</body>
</html>
